
module axi3_reader_tie_off#(int AXI_WIDTH, int ADDR_WIDTH) {
    domain axi3
    // axi mm master
    // read channels - tie off, never ready/valid
    output bool                     arvalid'0 = false
    input  bool                     arready'0
    output int#(FROM: 0, TO: 1 << ADDR_WIDTH)         araddr'0 = 0
    output int#(FROM: 0, TO: 8)     arsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                  arburst'0 = 2'b00
    output bool[4]                  arcache'0 = 4'b0000
    output bool[3]                  arprot'0 = 3'b00
    output int#(FROM: 0, TO: 16)    arlen'0 = 0
    output bool[2]                  arlock'0 = 2'b00
    input  bool                     rvalid'0
    output bool                     rready'0 = false
    input  bool                     rlast'0
    input  bool[AXI_WIDTH]          rdata'0
    input  bool[2]                  rresp'0
    bool _arready = arready
    bool _rvalid = rvalid
    bool[AXI_WIDTH] _rdata = rdata
    bool[2] _rresp = rresp
    bool _rlast = rlast
}

module axi3_writer_tie_off#(int AXI_WIDTH, int ADDR_WIDTH) {
    domain axi3
    // axi mm master
    // write channels - tie off, never ready/valid
    output bool                     awvalid'0 = false
    input  bool                     awready'0
    output int#(FROM: 0, TO: 1 << ADDR_WIDTH)         awaddr'0 = 0
    output int#(FROM: 0, TO: 8)     awsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                  awburst'0 = 2'b00
    output bool[4]                  awcache'0 = 4'b0000
    output bool[3]                  awprot'0 = 3'b000
    output int#(FROM: 0, TO: 16)    awlen'0 = 0
    output bool[2]                  awlock'0 = 2'b00
    output bool                     wvalid'0 = false
    input  bool                     wready'0
    output bool                     wlast'0 = false
    output bool[AXI_WIDTH]          wdata'0 = RepeatGen#(T: type bool, V: false, SIZE: AXI_WIDTH)
    output bool[AXI_WIDTH / 8]      wstrb'0 = RepeatGen#(T: type bool, V: false, SIZE: AXI_WIDTH / 8)
    input  bool                     bvalid'0
    output bool                     bready'0 = false
    input  bool[2]                  bresp'0
    bool _awready = awready
    bool _wready = wready
    bool _bvalid = bvalid
    bool[2] _bresp = bresp
}

module axi4_reader_tie_off#(int AXI_WIDTH, int ADDR_WIDTH) {
    domain axi4
    // axi mm master
    // read channels - tie off, never ready/valid
    output bool                     arvalid'0 = false
    input  bool                     arready'0
    output int#(FROM: 0, TO: 1 << ADDR_WIDTH)         araddr'0 = 0
    output int#(FROM: 0, TO: 256)   arlen'0 = 0
    output int#(FROM: 0, TO: 8)     arsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                  arburst'0 = 2'b00
    output bool[3]                  arprot'0 = 3'b00
    output bool[4]                  arcache'0 = 4'b0000
    output int#(FROM: 0, TO: 16)    arqos'0 = 0
    output bool                     arlock'0 = false
    output int#(FROM: 0, TO: 16)    arregion'0 = 0
    input  bool                     rvalid'0
    output bool                     rready'0 = false
    input  bool[AXI_WIDTH]          rdata'0
    input  bool[2]                  rresp'0
    input  bool                     rlast'0
    bool _arready = arready
    bool _rvalid = rvalid
    bool[AXI_WIDTH] _rdata = rdata
    bool[2] _rresp = rresp
    bool _rlast = rlast
}

module axi4_writer_tie_off#(int AXI_WIDTH, int ADDR_WIDTH) {
    domain axi4
    // axi mm master
    // write channels - tie off, never ready/valid
    output bool                     awvalid'0 = false
    input  bool                     awready'0
    output int#(FROM: 0, TO: 1 << ADDR_WIDTH)         awaddr'0 = 0
    output int#(FROM: 0, TO: 256)   awlen'0 = 0
    output int#(FROM: 0, TO: 8)     awsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                  awburst'0 = 2'b00
    output bool[3]                  awprot'0 = 3'b000
    output bool[4]                  awcache'0 = 4'b0000
    output int#(FROM: 0, TO: 16)    awqos'0 = 0
    output bool                     awlock'0 = false
    output int#(FROM: 0, TO: 16)    awregion'0 = 0
    output bool                     wvalid'0 = false
    input  bool                     wready'0
    output bool[AXI_WIDTH]          wdata'0 = RepeatGen#(T: type bool, V: false, SIZE: AXI_WIDTH)
    output bool[AXI_WIDTH / 8]      wstrb'0 = RepeatGen#(T: type bool, V: false, SIZE: AXI_WIDTH / 8)
    output bool                     wlast'0 = false
    input  bool                     bvalid'0
    input  bool[2]                  bresp'0
    output bool                     bready'0 = false
    bool _awready = awready
    bool _wready = wready
    bool _bvalid = bvalid
    bool[2] _bresp = bresp
}

/// MakeMask(3) = [true, true, true, false, false, ...]
module MakeMask#(int SIZE) {
    interface MakeMask : int#(FROM: 0, TO: SIZE + 1) up_to -> bool[SIZE] bits

    for int I in 0..SIZE {
        bits[I] = up_to > I
    }
}

module MakeStrobe #(int STROBE_WIDTH) {
    interface MakeStrobe : int#(FROM: 0, TO: STROBE_WIDTH+1) chunk_length'0, int#(FROM: 0, TO: STROBE_WIDTH) chunk_offset'0 -> bool[STROBE_WIDTH] strobe

    strobe = RotateRight(MakeMask(chunk_length), chunk_offset)
}

/// Similar interface to [axi3_burst_reader]. Used to determine optimal values for [axi3_burst_reader::MAX_IN_FLIGHT]
module axi3_burst_reader_benchmarker #(int AXI_WIDTH, int ADDR_WIDTH, int ADDR_ALIGN, int COUNT_TO) {
    gen int AXI_WIDTH_BYTES = AXI_WIDTH / 8
    gen int AxSIZE = clog2#(V: AXI_WIDTH_BYTES)

    /// Check AXI_WIDTH is a power of two
    assert#(C: pow2#(E: AxSIZE) * 8 == AXI_WIDTH)
    /// AXI standard supported AXI_WIDTHs: 8 - 1024
    assert#(C: (AxSIZE >= 0) & (AxSIZE < 8))

    /// For XRT: Supported AXI_WIDTH ranges from 32-512
    assert#(C: (AXI_WIDTH == 32) | (AXI_WIDTH == 64) | (AXI_WIDTH == 128) | (AXI_WIDTH == 256) | (AXI_WIDTH == 512))

    gen int MAX_AXI_ALIGNMENT = pow2#(E: 12)
    // DOES NOT WORK :(
    //gen int MAX_AXI_ALIGNMENT = pow2#(E: 14) // BREAKING AXI SPEC - 8KB pages for 256, 16KB for 512. Result = Higher BW? 
    gen int MAX_BURST = MAX_AXI_ALIGNMENT / AXI_WIDTH_BYTES

    if MAX_BURST > 16 { // Limited to 16 for BURST_INCR - AXI3.
        MAX_BURST = 16
    }

    gen int ELEMENT_BITWIDTH = ADDR_ALIGN * 8
    /// The alignment is a power of two
    assert#(C: pow2#(E: clog2#(V: ADDR_ALIGN)) == ADDR_ALIGN)
    gen int NUM_PARALLEL_ELEMENTS = AXI_WIDTH / ELEMENT_BITWIDTH
    assert#(C: AXI_WIDTH mod ELEMENT_BITWIDTH == 0)

    gen int MAX_BURST_ELEMENTS = MAX_BURST * NUM_PARALLEL_ELEMENTS

    domain axi3
    // axi interface
    state int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH) / (AXI_WIDTH / 8)) araddr_transfer
    output state bool                         arvalid'0
    input  bool                               arready'0
    output int#(FROM: 0, TO: 1 << ADDR_WIDTH) araddr'0 = araddr_transfer << clog2#(V: AXI_WIDTH / 8)
    output int#(FROM: 0, TO: 8)               arsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                            arburst'0 = 2'b01 // BURST_INC
    output bool[4]                            arcache'0 = 4'b0010 // Not bufferable, but can be broken up (into 128-bit, or other)
    output bool[3]                            arprot'0 = 3'b000 // Unprivileged, Secure, Data Access
    output state int#(FROM: 0, TO: 16)        arlen'0
    output bool[2]                            arlock'0 = 2'b00 // NORMAL - No atomics
    input  bool                               rvalid'0
    output state bool                         rready'0
    input  bool                               rlast'0
    input  bool[AXI_WIDTH]                    rdata'0
    input  bool[2]                            rresp'0
    bool[2] _rresp =                          rresp

    state bool cur_addr_valid
    state int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH) / ADDR_ALIGN) cur_addr
    state int#(FROM: 0, TO: COUNT_TO) elements_remaining

    SlowStablePipelineCustom#(PIPELINE_DEPTH: 1) feedback_loop
    Tuple2 pack_feedback_loop
    feedback_loop.pipeline_in = pack_feedback_loop.pack(cur_addr, elements_remaining)

    int cur_addr_begin_pipeline'-1, int elements_remaining_begin_pipeline'-1 = pack_feedback_loop.unpack(feedback_loop.pipeline_out)

    int addr_burst, int first_elem_in_burst = BitwiseIntSplit#(LOWER_BITS: clog2#(V: MAX_BURST * NUM_PARALLEL_ELEMENTS))(cur_addr_begin_pipeline)
    int first_transfer_idx, int first_elem_in_transfer = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(first_elem_in_burst)

    reg int next_addr_burst_idx = addr_burst+1 mod pow2#(E: ADDR_WIDTH) / (MAX_BURST_ELEMENTS * ADDR_ALIGN)

    // The feedback loop pipeline
    int max_number_of_elements_in_this_burst = MAX_BURST_ELEMENTS - first_elem_in_burst
    reg int reduced_elements_remaining = elements_remaining_begin_pipeline - max_number_of_elements_in_this_burst
    bool is_last = reduced_elements_remaining <= 0

    // If we requested a 0-element burst, we don't actually make a request, we just send of a "0-burst" command. 
    reg bool is_zero_sized_burst = elements_remaining_begin_pipeline == 0
    int arlen_remaining = elements_remaining_begin_pipeline + first_elem_in_transfer - 1

    /// (start_align, end_align (inclusive), is_last_burst, is_zero_sized_burst)
    Tuple4 command_tuple
    // 256 bursts in flight aught to be enough for anyone
    FWFT#(DEPTH: 256) command_fifo

    gen int MAX_IN_FLIGHT_BOUND = pow2#(E: 16)

    /// Small register updated every cycle keeping live track of how many transfers are in flight. If < MAX_BURST then we can't request more bursts before 
    state int#(FROM: 0, TO: MAX_IN_FLIGHT_BOUND) in_flight_headroom

    domain read_requests
    output bool may_request_new_read'0 = !cur_addr_valid
    action request_new_read'0 : int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH)) start_addr'0, int#(FROM: 0, TO: COUNT_TO) count'0 {
        int elem_addr, int _misalign = BitwiseIntSplit#(LOWER_BITS: clog2#(V: ADDR_ALIGN))(start_addr)

        cur_addr_valid = true
        cur_addr = elem_addr
        elements_remaining = count
        feedback_loop.input_changed()
    }

    int num_transfers_in_this_burst
    when arvalid & arready {
        num_transfers_in_this_burst = arlen
        arvalid = false
    } else {
        num_transfers_in_this_burst = -1
    }
    // Should synthesize to a simple adder with carry
    in_flight_headroom = IntNarrow#(FROM: 0, TO: MAX_IN_FLIGHT_BOUND)(in_flight_headroom - num_transfers_in_this_burst - (1 - BoolToInt(rready & rvalid)))

    domain data
    // It's not possible to encode the backpressure when we have a dynamic MAX_IN_FLIGHT. Luckily, since this is for benchmarking, we simply 
    bool ready_for_lots_of_data = true
    trigger chunk_valid'0: bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) chunk_length'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) chunk_offset'0, bool last'0

    bool offset_receiver_is_ready = ready_for_lots_of_data
    /*
    input bool ready_for_lots_of_data'-MAX_IN_FLIGHT
    bool offset_receiver_is_ready = LatencyOffset#(OFFSET: MAX_IN_FLIGHT)(ready_for_lots_of_data)
    trigger chunk_valid'0: bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) chunk_length'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) chunk_offset'0, bool last'0
    */

    when cur_addr_valid & in_flight_headroom >= MAX_BURST & offset_receiver_is_ready & !arvalid & command_fifo.may_push & feedback_loop.pipeline_stable {
        int final_align
        int new_arlen
        when is_last {
            // The final burst doesn't require us to update the address. 
            int#(FROM: 0, TO: MAX_BURST_ELEMENTS) final_burst_arlen = IntNarrow#(FROM: 0, TO: MAX_BURST_ELEMENTS)(arlen_remaining)
            new_arlen, final_align = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(final_burst_arlen)
            cur_addr_valid = false
        } else {
            // It's not the end of the read
            
            new_arlen = MAX_BURST - 1 - first_transfer_idx
            final_align = NUM_PARALLEL_ELEMENTS - 1

            elements_remaining = IntNarrow#(FROM: 1, TO: COUNT_TO)(reduced_elements_remaining)
            cur_addr = BitwiseIntConcat#(LOWER_BITS: clog2#(V: MAX_BURST_ELEMENTS))(next_addr_burst_idx, 0)
            feedback_loop.input_changed()
        }

        arlen = new_arlen
        arvalid = !is_zero_sized_burst
        araddr_transfer, int _align = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(cur_addr)

        reg bool[] packed_command = command_tuple.pack(first_elem_in_transfer, final_align, is_last, is_zero_sized_burst)
        command_fifo.push(packed_command)
    }

    
    state int chunk_offset
    state int stored_end_align
    state bool stored_is_last
    state bool stored_is_empty_burst

    bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements
    for int I in 0..NUM_PARALLEL_ELEMENTS {
        elements[I] = rdata[I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH]
    }

    int chunk_length
    bool is_final_last
    when stored_is_empty_burst{
        is_final_last = true
        chunk_length = 0
    } else {
        is_final_last = rlast & stored_is_last
        when is_final_last {
            chunk_length = IntNarrow#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS + 1)(stored_end_align + 1 - chunk_offset)
        } else {
            chunk_length = NUM_PARALLEL_ELEMENTS - chunk_offset
        }
    }
    when rready & rvalid | stored_is_empty_burst {
        // For a zero-sized burst, the elements will be invalid data. This is acceptable, since the associated strobe is 'b000000...
        chunk_valid(elements, chunk_length, chunk_offset, is_final_last)
        chunk_offset = 0
        stored_is_empty_burst = false
    }
    
    bool should_get_new_burst = rready & rvalid & rlast | stored_is_empty_burst | !rready
    when should_get_new_burst {
        when command_fifo.pop_available : bool[] pop_data {
            command_fifo.pop()
            int cmd_start_align, int cmd_end_align, bool cmd_is_last, bool cmd_is_empty_burst = command_tuple.unpack(pop_data)

            chunk_offset = cmd_start_align // Takes prescedence over the setting to 0 when sending the last one
            stored_end_align = cmd_end_align
            stored_is_last = cmd_is_last
            stored_is_empty_burst = cmd_is_empty_burst // Takes prescedence over the setting to false when sending the last one

            rready = !cmd_is_empty_burst
        } else {
            rready = false
        }
    }

    domain reset
    /// Set this at the beginning of a run, to initialize the run with this MAX_IN_FLIGHT value. MAY NOT BE CALLED WHILE READS ARE IN PROGRESS
    action initialize_max_in_flight : int#(FROM: 0, TO: MAX_IN_FLIGHT_BOUND) max_in_flight {
        in_flight_headroom = max_in_flight
    }

    action rst {
        arvalid = false
        stored_is_empty_burst = false
        rready = false
        cur_addr_valid = false
        //in_flight_headroom = MAX_IN_FLIGHT
        command_fifo.rst()
        feedback_loop.rst()
    }
}

/// Similar interface to [axi4_burst_reader]. Used to determine optimal values for [axi4_burst_reader::MAX_IN_FLIGHT]
module axi4_burst_reader_benchmarker #(int AXI_WIDTH, int ADDR_WIDTH, int ADDR_ALIGN, int COUNT_TO) {
    gen int AXI_WIDTH_BYTES = AXI_WIDTH / 8
    gen int AxSIZE = clog2#(V: AXI_WIDTH_BYTES)

    /// Check AXI_WIDTH is a power of two
    assert#(C: pow2#(E: AxSIZE) * 8 == AXI_WIDTH)
    /// AXI standard supported AXI_WIDTHs: 8 - 1024
    assert#(C: (AxSIZE >= 0) & (AxSIZE < 8))

    /// For XRT: Supported AXI_WIDTH ranges from 32-512
    assert#(C: (AXI_WIDTH == 32) | (AXI_WIDTH == 64) | (AXI_WIDTH == 128) | (AXI_WIDTH == 256) | (AXI_WIDTH == 512))

    gen int MAX_AXI_ALIGNMENT = pow2#(E: 12)
    // DOES NOT WORK :(
    //gen int MAX_AXI_ALIGNMENT = pow2#(E: 14) // BREAKING AXI SPEC - 8KB pages for 256, 16KB for 512. Result = Higher BW? 
    gen int MAX_BURST = MAX_AXI_ALIGNMENT / AXI_WIDTH_BYTES

    if MAX_BURST > 256 { // Limited to 256 for BURST_INCR - AXI4.
        MAX_BURST = 256
    }

    gen int ELEMENT_BITWIDTH = ADDR_ALIGN * 8
    /// The alignment is a power of two
    assert#(C: pow2#(E: clog2#(V: ADDR_ALIGN)) == ADDR_ALIGN)
    gen int NUM_PARALLEL_ELEMENTS = AXI_WIDTH / ELEMENT_BITWIDTH
    assert#(C: AXI_WIDTH mod ELEMENT_BITWIDTH == 0)

    gen int MAX_BURST_ELEMENTS = MAX_BURST * NUM_PARALLEL_ELEMENTS

    domain axi4
    // axi interface
    output state bool                     arvalid'0
    input  bool                           arready'0
    state int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH) / (AXI_WIDTH / 8)) araddr_transfer
    output int#(FROM: 0, TO: 1 << ADDR_WIDTH) araddr'0 = araddr_transfer << clog2#(V: AXI_WIDTH / 8)
    output state int#(FROM: 0, TO: 256)   arlen'0
    output int#(FROM: 0, TO: 8)           arsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                        arburst'0 = 2'b01 // BURST_INC
    output bool[3]                        arprot'0 = 3'b000 // Unprivileged, Secure, Data Access
    output bool[4]                        arcache'0 = 4'b0010 // Not bufferable, but can be broken up (into 128-bit, or other)
    output int#(FROM: 0, TO: 16)          arqos'0 = 0 // Lowest priority
    output bool                           arlock'0 = false // NORMAL - No atomics
    output int#(FROM: 0, TO: 16)          arregion'0 = 0 // Region 0
    input  bool                           rvalid'0
    output state bool                     rready'0
    input  bool[AXI_WIDTH]                rdata'0
    input  bool[2]                        rresp'0
    bool[2] _rresp = rresp
    input  bool                           rlast'0

    state bool cur_addr_valid
    state int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH) / ADDR_ALIGN) cur_addr
    state int#(FROM: 0, TO: COUNT_TO) elements_remaining

    SlowStablePipelineCustom#(PIPELINE_DEPTH: 1) feedback_loop
    Tuple2 pack_feedback_loop
    feedback_loop.pipeline_in = pack_feedback_loop.pack(cur_addr, elements_remaining)

    int cur_addr_begin_pipeline'-1, int elements_remaining_begin_pipeline'-1 = pack_feedback_loop.unpack(feedback_loop.pipeline_out)

    int addr_burst, int first_elem_in_burst = BitwiseIntSplit#(LOWER_BITS: clog2#(V: MAX_BURST * NUM_PARALLEL_ELEMENTS))(cur_addr_begin_pipeline)
    int first_transfer_idx, int first_elem_in_transfer = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(first_elem_in_burst)

    reg int next_addr_burst_idx = addr_burst+1 mod pow2#(E: ADDR_WIDTH) / (MAX_BURST_ELEMENTS * ADDR_ALIGN)

    // The feedback loop pipeline
    int max_number_of_elements_in_this_burst = MAX_BURST_ELEMENTS - first_elem_in_burst
    reg int reduced_elements_remaining = elements_remaining_begin_pipeline - max_number_of_elements_in_this_burst
    bool is_last = reduced_elements_remaining <= 0

    // If we requested a 0-element burst, we don't actually make a request, we just send of a "0-burst" command. 
    reg bool is_zero_sized_burst = elements_remaining_begin_pipeline == 0
    int arlen_remaining = elements_remaining_begin_pipeline + first_elem_in_transfer - 1

    /// (start_align, end_align (inclusive), is_last_burst, is_zero_sized_burst)
    Tuple4 command_tuple
    // 256 bursts in flight aught to be enough for anyone
    FWFT#(DEPTH: 256) command_fifo

    gen int MAX_IN_FLIGHT_BOUND = pow2#(E: 16)

    /// Small register updated every cycle keeping live track of how many transfers are in flight. If < MAX_BURST then we can't request more bursts before 
    state int#(FROM: 0, TO: MAX_IN_FLIGHT_BOUND) in_flight_headroom

    domain read_requests
    output bool may_request_new_read'0 = !cur_addr_valid
    action request_new_read'0 : int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH)) start_addr'0, int#(FROM: 0, TO: COUNT_TO) count'0 {
        int elem_addr, int _misalign = BitwiseIntSplit#(LOWER_BITS: clog2#(V: ADDR_ALIGN))(start_addr)

        cur_addr_valid = true
        cur_addr = elem_addr
        elements_remaining = count
        feedback_loop.input_changed()
    }

    int num_transfers_in_this_burst
    when arvalid & arready {
        num_transfers_in_this_burst = arlen
        arvalid = false
    } else {
        num_transfers_in_this_burst = -1
    }
    // Should synthesize to a simple adder with carry
    in_flight_headroom = IntNarrow#(FROM: 0, TO: MAX_IN_FLIGHT_BOUND)(in_flight_headroom - num_transfers_in_this_burst - (1 - BoolToInt(rready & rvalid)))

    domain data
    // It's not possible to encode the backpressure when we have a dynamic MAX_IN_FLIGHT. Luckily, since this is for benchmarking, we simply 
    bool ready_for_lots_of_data = true
    trigger chunk_valid'0: bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) chunk_length'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) chunk_offset'0, bool last'0

    bool offset_receiver_is_ready = ready_for_lots_of_data
    /*
    input bool ready_for_lots_of_data'-MAX_IN_FLIGHT
    bool offset_receiver_is_ready = LatencyOffset#(OFFSET: MAX_IN_FLIGHT)(ready_for_lots_of_data)
    trigger chunk_valid'0: bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) chunk_length'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) chunk_offset'0, bool last'0
    */

    when cur_addr_valid & in_flight_headroom >= MAX_BURST & offset_receiver_is_ready & !arvalid & command_fifo.may_push & feedback_loop.pipeline_stable {
        int final_align
        int new_arlen
        when is_last {
            // The final burst doesn't require us to update the address. 
            int#(FROM: 0, TO: MAX_BURST_ELEMENTS) final_burst_arlen = IntNarrow#(FROM: 0, TO: MAX_BURST_ELEMENTS)(arlen_remaining)
            new_arlen, final_align = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(final_burst_arlen)
            cur_addr_valid = false
        } else {
            // It's not the end of the read
            
            new_arlen = MAX_BURST - 1 - first_transfer_idx
            final_align = NUM_PARALLEL_ELEMENTS - 1

            elements_remaining = IntNarrow#(FROM: 1, TO: COUNT_TO)(reduced_elements_remaining)
            cur_addr = BitwiseIntConcat#(LOWER_BITS: clog2#(V: MAX_BURST_ELEMENTS))(next_addr_burst_idx, 0)
            feedback_loop.input_changed()
        }

        arlen = new_arlen
        arvalid = !is_zero_sized_burst
        araddr_transfer, int _align = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(cur_addr)

        reg bool[] packed_command = command_tuple.pack(first_elem_in_transfer, final_align, is_last, is_zero_sized_burst)
        command_fifo.push(packed_command)
    }

    
    state int chunk_offset
    state int stored_end_align
    state bool stored_is_last
    state bool stored_is_empty_burst

    bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements
    for int I in 0..NUM_PARALLEL_ELEMENTS {
        elements[I] = rdata[I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH]
    }

    int chunk_length
    bool is_final_last
    when stored_is_empty_burst{
        is_final_last = true
        chunk_length = 0
    } else {
        is_final_last = rlast & stored_is_last
        when is_final_last {
            chunk_length = IntNarrow#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS + 1)(stored_end_align + 1 - chunk_offset)
        } else {
            chunk_length = NUM_PARALLEL_ELEMENTS - chunk_offset
        }
    }
    when rready & rvalid | stored_is_empty_burst {
        // For a zero-sized burst, the elements will be invalid data. This is acceptable, since the associated strobe is 'b000000...
        chunk_valid(elements, chunk_length, chunk_offset, is_final_last)
        chunk_offset = 0
        stored_is_empty_burst = false
    }
    
    bool should_get_new_burst = rready & rvalid & rlast | stored_is_empty_burst | !rready
    when should_get_new_burst {
        when command_fifo.pop_available : bool[] pop_data {
            command_fifo.pop()
            int cmd_start_align, int cmd_end_align, bool cmd_is_last, bool cmd_is_empty_burst = command_tuple.unpack(pop_data)

            chunk_offset = cmd_start_align // Takes prescedence over the setting to 0 when sending the last one
            stored_end_align = cmd_end_align
            stored_is_last = cmd_is_last
            stored_is_empty_burst = cmd_is_empty_burst // Takes prescedence over the setting to false when sending the last one

            rready = !cmd_is_empty_burst
        } else {
            rready = false
        }
    }

    domain reset
    /// Set this at the beginning of a run, to initialize the run with this MAX_IN_FLIGHT value. MAY NOT BE CALLED WHILE READS ARE IN PROGRESS
    action initialize_max_in_flight : int#(FROM: 0, TO: MAX_IN_FLIGHT_BOUND) max_in_flight {
        in_flight_headroom = max_in_flight
    }

    action rst {
        arvalid = false
        stored_is_empty_burst = false
        rready = false
        cur_addr_valid = false
        //in_flight_headroom = MAX_IN_FLIGHT
        command_fifo.rst()
        feedback_loop.rst()
    }
}

module axi3_burst_reader #(ExtraDataT, int AXI_WIDTH, int ADDR_WIDTH, int ADDR_ALIGN, int COUNT_TO, int MAX_IN_FLIGHT) {
    gen int AXI_WIDTH_BYTES = AXI_WIDTH / 8
    gen int AxSIZE = clog2#(V: AXI_WIDTH_BYTES)

    /// Check AXI_WIDTH is a power of two
    assert#(C: pow2#(E: AxSIZE) * 8 == AXI_WIDTH)
    /// AXI standard supported AXI_WIDTHs: 8 - 1024
    assert#(C: (AxSIZE >= 0) & (AxSIZE < 8))

    /// For XRT: Supported AXI_WIDTH ranges from 32-512
    assert#(C: (AXI_WIDTH == 32) | (AXI_WIDTH == 64) | (AXI_WIDTH == 128) | (AXI_WIDTH == 256) | (AXI_WIDTH == 512))

    gen int MAX_AXI_ALIGNMENT = pow2#(E: 12)
    // DOES NOT WORK :(
    //gen int MAX_AXI_ALIGNMENT = pow2#(E: 14) // BREAKING AXI SPEC - 8KB pages for 256, 16KB for 512. Result = Higher BW? 
    gen int MAX_BURST = MAX_AXI_ALIGNMENT / AXI_WIDTH_BYTES

    if MAX_BURST > 16 { // Limited to 16 for BURST_INCR - AXI4.
        MAX_BURST = 16
    }

    gen int ELEMENT_BITWIDTH = ADDR_ALIGN * 8
    /// The alignment is a power of two
    assert#(C: pow2#(E: clog2#(V: ADDR_ALIGN)) == ADDR_ALIGN)
    gen int NUM_PARALLEL_ELEMENTS = AXI_WIDTH / ELEMENT_BITWIDTH
    assert#(C: AXI_WIDTH mod ELEMENT_BITWIDTH == 0)

    gen int MAX_BURST_ELEMENTS = MAX_BURST * NUM_PARALLEL_ELEMENTS

    domain axi3
    // axi interface
    state int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH) / (AXI_WIDTH / 8)) araddr_transfer
    output state bool                         arvalid'0
    input  bool                               arready'0
    output int#(FROM: 0, TO: 1 << ADDR_WIDTH) araddr'0 = araddr_transfer << clog2#(V: AXI_WIDTH / 8)
    output int#(FROM: 0, TO: 8)               arsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                            arburst'0 = 2'b01 // BURST_INC
    output bool[4]                            arcache'0 = 4'b0010 // Not bufferable, but can be broken up (into 128-bit, or other)
    output bool[3]                            arprot'0 = 3'b000 // Unprivileged, Secure, Data Access
    output state int#(FROM: 0, TO: 16)        arlen'0
    output bool[2]                            arlock'0 = 2'b00 // NORMAL - No atomics
    input  bool                               rvalid'0
    output state bool                         rready'0
    input  bool                               rlast'0
    input  bool[AXI_WIDTH]                    rdata'0
    input  bool[2]                            rresp'0
    bool[2] _rresp =                          rresp

    state bool cur_addr_valid
    state int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH) / ADDR_ALIGN) cur_addr
    state int#(FROM: 0, TO: COUNT_TO) elements_remaining
    state ExtraDataT stored_extra_data

    SlowStablePipelineCustom#(PIPELINE_DEPTH: 1) feedback_loop
    Tuple2 pack_feedback_loop
    feedback_loop.pipeline_in = pack_feedback_loop.pack(cur_addr, elements_remaining)

    int cur_addr_begin_pipeline'-1, int elements_remaining_begin_pipeline'-1 = pack_feedback_loop.unpack(feedback_loop.pipeline_out)

    int addr_burst, int first_elem_in_burst = BitwiseIntSplit#(LOWER_BITS: clog2#(V: MAX_BURST * NUM_PARALLEL_ELEMENTS))(cur_addr_begin_pipeline)
    int first_transfer_idx, int first_elem_in_transfer = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(first_elem_in_burst)

    reg int next_addr_burst_idx = addr_burst+1 mod pow2#(E: ADDR_WIDTH) / (MAX_BURST_ELEMENTS * ADDR_ALIGN)

    // The feedback loop pipeline
    int max_number_of_elements_in_this_burst = MAX_BURST_ELEMENTS - first_elem_in_burst
    reg int reduced_elements_remaining = elements_remaining_begin_pipeline - max_number_of_elements_in_this_burst
    bool is_last = reduced_elements_remaining <= 0

    // If we requested a 0-element burst, we don't actually make a request, we just send of a "0-burst" command. 
    reg bool is_zero_sized_burst = elements_remaining_begin_pipeline == 0
    int arlen_remaining = elements_remaining_begin_pipeline + first_elem_in_transfer - 1

    /// (start_align, end_align (inclusive), is_last_burst, is_zero_sized_burst, extra_data)
    Tuple5 command_tuple
    // 256 bursts in flight aught to be enough for anyone
    FWFT#(DEPTH: 256) command_fifo

    /// Small register updated every cycle keeping live track of how many transfers are in flight. If < MAX_BURST then we can't request more bursts before 
    state int#(FROM: 0, TO: MAX_IN_FLIGHT+1) in_flight_headroom

    domain read_requests
    output bool may_request_new_read'0 = !cur_addr_valid
    action request_new_read'0 : int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH)) start_addr'0, int#(FROM: 0, TO: COUNT_TO) count'0, ExtraDataT extra_data'0 {
        int elem_addr, int _misalign = BitwiseIntSplit#(LOWER_BITS: clog2#(V: ADDR_ALIGN))(start_addr)

        cur_addr_valid = true
        cur_addr = elem_addr
        elements_remaining = count
        stored_extra_data = extra_data
        feedback_loop.input_changed()
    }

    int num_transfers_in_this_burst
    when arvalid & arready {
        num_transfers_in_this_burst = arlen
        arvalid = false
    } else {
        num_transfers_in_this_burst = -1
    }
    // Should synthesize to a simple adder with carry
    bool enough_in_flight_headroom
    if MAX_IN_FLIGHT != 0 {
        in_flight_headroom = IntNarrow#(FROM: 0, TO: MAX_IN_FLIGHT+1)(in_flight_headroom - num_transfers_in_this_burst - (1 - BoolToInt(rready & rvalid)))
        enough_in_flight_headroom = in_flight_headroom >= MAX_BURST
    } else {
        enough_in_flight_headroom = true
    }

    domain data
    input bool ready_for_lots_of_data'-MAX_IN_FLIGHT
    bool offset_receiver_is_ready
    if MAX_IN_FLIGHT != 0 {
        offset_receiver_is_ready = LatencyOffset#(OFFSET: MAX_IN_FLIGHT)(ready_for_lots_of_data)
    } else {
        offset_receiver_is_ready = true
    }

    trigger chunk_valid'0: bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) chunk_length'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) chunk_offset'0, bool last'0, ExtraDataT extra_data_out'0

    when cur_addr_valid & enough_in_flight_headroom & offset_receiver_is_ready & !arvalid & command_fifo.may_push & feedback_loop.pipeline_stable {
        int final_align
        int new_arlen
        when is_last {
            // The final burst doesn't require us to update the address. 
            int#(FROM: 0, TO: MAX_BURST_ELEMENTS) final_burst_arlen = IntNarrow#(FROM: 0, TO: MAX_BURST_ELEMENTS)(arlen_remaining)
            new_arlen, final_align = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(final_burst_arlen)
            cur_addr_valid = false
        } else {
            // It's not the end of the read
            
            new_arlen = MAX_BURST - 1 - first_transfer_idx
            final_align = NUM_PARALLEL_ELEMENTS - 1

            elements_remaining = IntNarrow#(FROM: 1, TO: COUNT_TO)(reduced_elements_remaining)
            cur_addr = BitwiseIntConcat#(LOWER_BITS: clog2#(V: MAX_BURST_ELEMENTS))(next_addr_burst_idx, 0)
            feedback_loop.input_changed()
        }

        arlen = new_arlen
        arvalid = !is_zero_sized_burst
        araddr_transfer, int _align = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(cur_addr)

        reg bool[] packed_command = command_tuple.pack(first_elem_in_transfer, final_align, is_last, is_zero_sized_burst, stored_extra_data)
        command_fifo.push(packed_command)
    }

    
    state int chunk_offset
    state int stored_end_align
    state bool stored_is_last
    state bool stored_is_empty_burst
    state ExtraDataT stored_extra_data_out

    bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements
    for int I in 0..NUM_PARALLEL_ELEMENTS {
        elements[I] = rdata[I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH]
    }

    int chunk_length
    bool is_final_last
    when stored_is_empty_burst{
        is_final_last = true
        chunk_length = 0
    } else {
        is_final_last = rlast & stored_is_last
        when is_final_last {
            chunk_length = IntNarrow#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS + 1)(stored_end_align + 1 - chunk_offset)
        } else {
            chunk_length = NUM_PARALLEL_ELEMENTS - chunk_offset
        }
    }
    when rready & rvalid | stored_is_empty_burst {
        // For a zero-sized burst, the elements will be invalid data. This is acceptable, since the associated strobe is 'b000000...
        chunk_valid(elements, chunk_length, chunk_offset, is_final_last, stored_extra_data_out)
        chunk_offset = 0
        stored_is_empty_burst = false
    }
    
    bool should_get_new_burst = rready & rvalid & rlast | stored_is_empty_burst | !rready
    when should_get_new_burst {
        when command_fifo.pop_available : bool[] pop_data {
            command_fifo.pop()
            int cmd_start_align, int cmd_end_align, bool cmd_is_last, bool cmd_is_empty_burst, ExtraDataT extra_data = command_tuple.unpack(pop_data)

            chunk_offset = cmd_start_align // Takes prescedence over the setting to 0 when sending the last one
            stored_end_align = cmd_end_align
            stored_is_last = cmd_is_last
            stored_is_empty_burst = cmd_is_empty_burst // Takes prescedence over the setting to false when sending the last one
            stored_extra_data_out = extra_data

            if MAX_IN_FLIGHT != 0 {
                rready = !cmd_is_empty_burst
            } else {
                rready = !cmd_is_empty_burst & ready_for_lots_of_data
            }
        } else {
            rready = false
        }
    }

    domain reset
    action rst {
        arvalid = false
        stored_is_empty_burst = false
        rready = false
        cur_addr_valid = false
        in_flight_headroom = MAX_IN_FLIGHT
        command_fifo.rst()
        feedback_loop.rst()
    }
}

/*
Vivado Utiliziation report for axi4_burst_reader#(AXI_WIDTH: 512, ADDR_ALIGN: 4, COUNT_TO: pow2#(E: 16), ATO: pow2#(E: 64))
+-------------------------+------+-------+------------+-----------+-------+
|        Site Type        | Used | Fixed | Prohibited | Available | Util% |
+-------------------------+------+-------+------------+-----------+-------+
| Registers               |  365 |     0 |          0 |   1799680 |  0.02 |
|   Register as Flip Flop |  365 |     0 |          0 |   1799680 |  0.02 |
|   Register as Latch     |    0 |     0 |          0 |   1799680 |  0.00 |
| CLB LUTs*               |  231 |     0 |          0 |    899840 |  0.03 |
|   LUT as Logic          |  231 |     0 |          0 |    899840 |  0.03 |
|   LUT as Memory         |    0 |     0 |          0 |    449920 |  0.00 |
| LOOKAHEAD8              |   12 |     0 |          0 |    112480 |  0.01 |
+-------------------------+------+-------+------------+-----------+-------+
*/
/// A Bursting AXI reader. It spends as little logic as possible, so aligning and backpressure are up to the user. 
///
/// Alignment is not handled by this module. Chunks are delivered on chunk_valid with a size and valid chunk count.
/// Data is not necessarily aligned to the start of the chunk. For alignment see [axi4_burst_reader]
///
/// Very coarse backpressure is provided in the form of the `ready_for_lots_of_data` wire.
/// Its latency count is set such that a receiving FIFO can set its `ALMOST_FULL` treshold
/// to receive all elements in flight (around 192..384).
///
/// `MAX_IN_FLIGHT` must be greater or equal to the minimum size of a transfer:
/// | AXI_WIDTH | MIN_TRANSFER_SIZE |
/// | ---  | --- |
/// | 8    | 256 |
/// | 16   | 256 |
/// | 32   | 256 |
/// | 64   | 256 |
/// | 128  | 256 |
/// | 256  | 128 |
/// | 512  | 64  |
/// | 1024 | 32  |
/// 
/// Or... you may set `MAX_IN_FLIGHT` to 0 for direct backpressure to the `r` channel.
/// However, it is discouraged to use `MAX_IN_FLIGHT=0` unless you know that:
/// - Your AXI slave can handle `r` channel backpressure
/// - A blocked transfer would not block other transfers on the same crossbar
/// Alternatively, if you know you will never backpressure the read channel (IE: `ready_for_lots_of_data == true` always),
/// then setting `MAX_IN_FLIGHT=0` is correct.
/// 
/// element: size is ADDR_ALIGN * 8. It is also the resolution of count
/// chunk: one AXI transfer. Contains AXI_WIDTH / (ADDR_ALIGN * 8) elements
/// burst: 1-256 chunks. The module handles converting the user's large bitwidth element `count` into a sequence of 4K page aligned bursts. `last` is only asserted at the end of the whole read
///
/// Output stream looks like:
/// ...XXXXX
/// XXXXXXXX
/// XXXXX...
/// due to alignment of address
module axi4_burst_reader #(ExtraDataT, int AXI_WIDTH, int ADDR_WIDTH, int ADDR_ALIGN, int COUNT_TO, int MAX_IN_FLIGHT) {
    gen int AXI_WIDTH_BYTES = AXI_WIDTH / 8
    gen int AxSIZE = clog2#(V: AXI_WIDTH_BYTES)

    /// Check AXI_WIDTH is a power of two
    assert#(C: pow2#(E: AxSIZE) * 8 == AXI_WIDTH)
    /// AXI standard supported AXI_WIDTHs: 8 - 1024
    assert#(C: (AxSIZE >= 0) & (AxSIZE < 8))

    /// For XRT: Supported AXI_WIDTH ranges from 32-512
    assert#(C: (AXI_WIDTH == 32) | (AXI_WIDTH == 64) | (AXI_WIDTH == 128) | (AXI_WIDTH == 256) | (AXI_WIDTH == 512))

    gen int MAX_AXI_ALIGNMENT = pow2#(E: 12)
    // DOES NOT WORK :(
    //gen int MAX_AXI_ALIGNMENT = pow2#(E: 14) // BREAKING AXI SPEC - 8KB pages for 256, 16KB for 512. Result = Higher BW? 
    gen int MAX_BURST = MAX_AXI_ALIGNMENT / AXI_WIDTH_BYTES

    if MAX_BURST > 256 { // Limited to 256 for BURST_INCR - AXI4.
        MAX_BURST = 256
    }

    gen int ELEMENT_BITWIDTH = ADDR_ALIGN * 8
    /// The alignment is a power of two
    assert#(C: pow2#(E: clog2#(V: ADDR_ALIGN)) == ADDR_ALIGN)
    gen int NUM_PARALLEL_ELEMENTS = AXI_WIDTH / ELEMENT_BITWIDTH
    assert#(C: AXI_WIDTH mod ELEMENT_BITWIDTH == 0)

    gen int MAX_BURST_ELEMENTS = MAX_BURST * NUM_PARALLEL_ELEMENTS

    domain axi4
    // axi interface
    state int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH) / (AXI_WIDTH / 8)) araddr_transfer
    output state bool                         arvalid'0
    input  bool                               arready'0
    output int#(FROM: 0, TO: 1 << ADDR_WIDTH) araddr'0 = araddr_transfer << clog2#(V: AXI_WIDTH / 8)
    output state int#(FROM: 0, TO: 256)       arlen'0
    output int#(FROM: 0, TO: 8)               arsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                            arburst'0 = 2'b01 // BURST_INC
    output bool[3]                            arprot'0 = 3'b000 // Unprivileged, Secure, Data Access
    output bool[4]                            arcache'0 = 4'b0010 // Not bufferable, but can be broken up (into 128-bit, or other)
    output int#(FROM: 0, TO: 16)              arqos'0 = 0 // Lowest priority
    output bool                               arlock'0 = false // NORMAL - No atomics
    output int#(FROM: 0, TO: 16)              arregion'0 = 0 // Region 0
    input  bool                               rvalid'0
    output state bool                         rready'0
    input  bool[AXI_WIDTH]                    rdata'0
    input  bool[2]                            rresp'0
    input  bool                               rlast'0
    bool[2] _rresp =                          rresp

    state bool cur_addr_valid
    state int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH) / ADDR_ALIGN) cur_addr
    state int#(FROM: 0, TO: COUNT_TO) elements_remaining
    state ExtraDataT stored_extra_data

    SlowStablePipelineCustom#(PIPELINE_DEPTH: 1) feedback_loop
    Tuple2 pack_feedback_loop
    feedback_loop.pipeline_in = pack_feedback_loop.pack(cur_addr, elements_remaining)

    int cur_addr_begin_pipeline'-1, int elements_remaining_begin_pipeline'-1 = pack_feedback_loop.unpack(feedback_loop.pipeline_out)

    int addr_burst, int first_elem_in_burst = BitwiseIntSplit#(LOWER_BITS: clog2#(V: MAX_BURST * NUM_PARALLEL_ELEMENTS))(cur_addr_begin_pipeline)
    int first_transfer_idx, int first_elem_in_transfer = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(first_elem_in_burst)

    reg int next_addr_burst_idx = addr_burst+1 mod pow2#(E: ADDR_WIDTH) / (MAX_BURST_ELEMENTS * ADDR_ALIGN)

    // The feedback loop pipeline
    int max_number_of_elements_in_this_burst = MAX_BURST_ELEMENTS - first_elem_in_burst
    reg int reduced_elements_remaining = elements_remaining_begin_pipeline - max_number_of_elements_in_this_burst
    bool is_last = reduced_elements_remaining <= 0

    // If we requested a 0-element burst, we don't actually make a request, we just send of a "0-burst" command. 
    reg bool is_zero_sized_burst = elements_remaining_begin_pipeline == 0
    int arlen_remaining = elements_remaining_begin_pipeline + first_elem_in_transfer - 1

    /// (start_align, end_align (inclusive), is_last_burst, is_zero_sized_burst, extra_data)
    Tuple5 command_tuple
    // 256 bursts in flight aught to be enough for anyone
    FWFT#(DEPTH: 256) command_fifo

    /// Small register updated every cycle keeping live track of how many transfers are in flight. If < MAX_BURST then we can't request more bursts before 
    state int#(FROM: 0, TO: MAX_IN_FLIGHT+1) in_flight_headroom

    domain read_requests
    output bool may_request_new_read'0 = !cur_addr_valid
    action request_new_read'0 : int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH)) start_addr'0, int#(FROM: 0, TO: COUNT_TO) count'0, ExtraDataT extra_data'0 {
        int elem_addr, int _misalign = BitwiseIntSplit#(LOWER_BITS: clog2#(V: ADDR_ALIGN))(start_addr)

        cur_addr_valid = true
        cur_addr = elem_addr
        elements_remaining = count
        stored_extra_data = extra_data
        feedback_loop.input_changed()
    }

    int num_transfers_in_this_burst
    when arvalid & arready {
        num_transfers_in_this_burst = arlen
        arvalid = false
    } else {
        num_transfers_in_this_burst = -1
    }
    // Should synthesize to a simple adder with carry
    bool enough_in_flight_headroom
    if MAX_IN_FLIGHT != 0 {
        in_flight_headroom = IntNarrow#(FROM: 0, TO: MAX_IN_FLIGHT+1)(in_flight_headroom - num_transfers_in_this_burst - (1 - BoolToInt(rready & rvalid)))
        enough_in_flight_headroom = in_flight_headroom >= MAX_BURST
    } else {
        enough_in_flight_headroom = true
    }

    domain data
    input bool ready_for_lots_of_data'-MAX_IN_FLIGHT
    bool offset_receiver_is_ready
    if MAX_IN_FLIGHT != 0 {
        offset_receiver_is_ready = LatencyOffset#(OFFSET: MAX_IN_FLIGHT)(ready_for_lots_of_data)
    } else {
        offset_receiver_is_ready = true
    }

    trigger chunk_valid'0: bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) chunk_length'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) chunk_offset'0, bool last'0, ExtraDataT extra_data_out'0

    when cur_addr_valid & enough_in_flight_headroom & offset_receiver_is_ready & !arvalid & command_fifo.may_push & feedback_loop.pipeline_stable {
        int final_align
        int new_arlen
        when is_last {
            // The final burst doesn't require us to update the address. 
            int#(FROM: 0, TO: MAX_BURST_ELEMENTS) final_burst_arlen = IntNarrow#(FROM: 0, TO: MAX_BURST_ELEMENTS)(arlen_remaining)
            new_arlen, final_align = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(final_burst_arlen)
            cur_addr_valid = false
        } else {
            // It's not the end of the read
            
            new_arlen = MAX_BURST - 1 - first_transfer_idx
            final_align = NUM_PARALLEL_ELEMENTS - 1

            elements_remaining = IntNarrow#(FROM: 1, TO: COUNT_TO)(reduced_elements_remaining)
            cur_addr = BitwiseIntConcat#(LOWER_BITS: clog2#(V: MAX_BURST_ELEMENTS))(next_addr_burst_idx, 0)
            feedback_loop.input_changed()
        }

        arlen = new_arlen
        arvalid = !is_zero_sized_burst
        araddr_transfer, int _align = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(cur_addr)

        reg bool[] packed_command = command_tuple.pack(first_elem_in_transfer, final_align, is_last, is_zero_sized_burst, stored_extra_data)
        command_fifo.push(packed_command)
    }

    
    state int chunk_offset
    state int stored_end_align
    state bool stored_is_last
    state bool stored_is_empty_burst
    state ExtraDataT stored_extra_data_out

    bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements
    for int I in 0..NUM_PARALLEL_ELEMENTS {
        elements[I] = rdata[I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH]
    }

    int chunk_length
    bool is_final_last
    when stored_is_empty_burst{
        is_final_last = true
        chunk_length = 0
    } else {
        is_final_last = rlast & stored_is_last
        when is_final_last {
            chunk_length = IntNarrow#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS + 1)(stored_end_align + 1 - chunk_offset)
        } else {
            chunk_length = NUM_PARALLEL_ELEMENTS - chunk_offset
        }
    }
    when rready & rvalid | stored_is_empty_burst {
        // For a zero-sized burst, the elements will be invalid data. This is acceptable, since the associated strobe is 'b000000...
        chunk_valid(elements, chunk_length, chunk_offset, is_final_last, stored_extra_data_out)
        chunk_offset = 0
        stored_is_empty_burst = false
    }
    
    bool should_get_new_burst = rready & rvalid & rlast | stored_is_empty_burst | !rready
    when should_get_new_burst {
        when command_fifo.pop_available : bool[] pop_data {
            command_fifo.pop()
            int cmd_start_align, int cmd_end_align, bool cmd_is_last, bool cmd_is_empty_burst, ExtraDataT extra_data = command_tuple.unpack(pop_data)

            chunk_offset = cmd_start_align // Takes prescedence over the setting to 0 when sending the last one
            stored_end_align = cmd_end_align
            stored_is_last = cmd_is_last
            stored_is_empty_burst = cmd_is_empty_burst // Takes prescedence over the setting to false when sending the last one
            stored_extra_data_out = extra_data

            if MAX_IN_FLIGHT != 0 {
                rready = !cmd_is_empty_burst
            } else {
                rready = !cmd_is_empty_burst & ready_for_lots_of_data
            }
        } else {
            rready = false
        }
    }

    domain reset
    action rst {
        arvalid = false
        stored_is_empty_burst = false
        rready = false
        cur_addr_valid = false
        in_flight_headroom = MAX_IN_FLIGHT
        command_fifo.rst()
        feedback_loop.rst()
    }
}

/// A Bursting and aligning AXI reader.
/// 
/// As 
/// 
/// Very coarse backpressure is provided in the form of the `ready_for_lots_of_data` wire. Its latency count is set such that a receiving FIFO can set its ALMOST_FULL treshold to receive all elements in flight (around 192..384). Can be set to constant 'true' if no backpressure needed
/// 
/// `last` is asserted for the last value
module axi4_realigning_burst_reader #(T, ExtraDataT, int AXI_WIDTH, int ADDR_WIDTH, int ADDR_ALIGN, int COUNT_TO, int MAX_IN_FLIGHT) {
    assert#(C: sizeof#(T) mod ADDR_ALIGN * 8 == 0)
    gen int ELEMENT_BITWIDTH = ADDR_ALIGN * 8
    gen int NUM_ELEMENTS_PER_VALUE = sizeof#(T) / ELEMENT_BITWIDTH
    gen int NUM_PARALLEL_ELEMENTS = AXI_WIDTH / ELEMENT_BITWIDTH
    // When T is bigger than AXI_WIDTH, multiple output cycles would be needed per input transfer. But with this AXI reader, we cannot provide backpressure (without a FIFO that is, of course)
    assert#(C: AXI_WIDTH <= sizeof#(T))
    axi4_burst_reader #(ExtraDataT, AXI_WIDTH, ADDR_WIDTH, ADDR_ALIGN, COUNT_TO: COUNT_TO * NUM_ELEMENTS_PER_VALUE, MAX_IN_FLIGHT) parent

    // export axi interface
    domain axi4_read
    output bool                     arvalid = parent.arvalid
    input  bool                     arready
    output int#(FROM: 0, TO: 1 << ADDR_WIDTH)         araddr  = parent.araddr
    output int#(FROM: 0, TO: 256)   arlen   = parent.arlen
    output int#(FROM: 0, TO: 8)     arsize  = parent.arsize
    output bool[2]                  arburst = parent.arburst
    output bool[3]                  arprot = parent.arprot
    output bool[4]                  arcache = parent.arcache
    output int#(FROM: 0, TO: 16)    arqos = parent.arqos
    output bool                     arlock = parent.arlock
    output int#(FROM: 0, TO: 16)    arregion = parent.arregion
    input  bool                     rvalid
    output bool                     rready  = parent.rready
    input  bool[AXI_WIDTH]          rdata
    input  bool[2]                  rresp
    input  bool                     rlast
    parent.arready = arready
    parent.rvalid  = rvalid
    parent.rdata   = rdata
    parent.rresp   = rresp
    parent.rlast   = rlast

    //input int#(FROM: 0, TO: 2048) max_in_flight
    //parent.max_in_flight = max_in_flight

    domain requests
    output bool may_request_new_read = parent.may_request_new_read
    action request_new_read : int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH)) start_addr, int#(FROM: 1, TO: COUNT_TO) count, ExtraDataT extra_data {
        parent.request_new_read(start_addr, count * NUM_ELEMENTS_PER_VALUE, extra_data)
    }

    domain data
    input bool ready_for_lots_of_data'-MAX_IN_FLIGHT
    parent.ready_for_lots_of_data = ready_for_lots_of_data

    trigger value_valid'0: T value'0, bool last'0, ExtraDataT extra_data_out'0

    state bool[ELEMENT_BITWIDTH][NUM_ELEMENTS_PER_VALUE-1] stored_elements
    state int#(FROM: 0, TO: NUM_ELEMENTS_PER_VALUE) cur_element_store_align
    when parent.chunk_valid : bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) chunk_length, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) chunk_offset, bool last, ExtraDataT extra_data {
        bool[ELEMENT_BITWIDTH][NUM_ELEMENTS_PER_VALUE] elements_extended
        elements_extended[:NUM_PARALLEL_ELEMENTS] = elements
        bool[ELEMENT_BITWIDTH][NUM_ELEMENTS_PER_VALUE] rotated_elements = RotateRight(elements_extended, cur_element_store_align - chunk_offset mod NUM_ELEMENTS_PER_VALUE)
        bool[NUM_ELEMENTS_PER_VALUE] rotated_strobe = MakeStrobe(chunk_length, cur_element_store_align)

        int end_of_element = cur_element_store_align + chunk_length

        when end_of_element >= NUM_ELEMENTS_PER_VALUE {
            bool[sizeof#(T)] resulting_value_bits
            gen int MUXES_START_FROM = NUM_ELEMENTS_PER_VALUE - NUM_PARALLEL_ELEMENTS
            for int ELEM_I in 0..NUM_ELEMENTS_PER_VALUE {
                if ELEM_I < MUXES_START_FROM {
                    resulting_value_bits[ELEM_I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH] = stored_elements[ELEM_I]
                } else if ELEM_I == NUM_ELEMENTS_PER_VALUE - 1 {
                    resulting_value_bits[ELEM_I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH] = rotated_elements[ELEM_I]
                } else {
                    when cur_element_store_align > ELEM_I {
                        resulting_value_bits[ELEM_I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH] = stored_elements[ELEM_I]
                    } else {
                        resulting_value_bits[ELEM_I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH] = rotated_elements[ELEM_I]
                    }
                }
            }
            // bool[sizeof#(T)] pipelined_resulting_value_bits'((clog2#(V: NUM_ELEMENTS_PER_VALUE) + 1) / 2) // Estimate 1 MUX4 per stage
            value_valid(FromBits(resulting_value_bits), last, extra_data)
        }
        cur_element_store_align = end_of_element mod NUM_ELEMENTS_PER_VALUE
        for int ELEM_I in 0..NUM_ELEMENTS_PER_VALUE-1 {
            when rotated_strobe[ELEM_I] {
                stored_elements[ELEM_I] = rotated_elements[ELEM_I]
            }
        }
    }

    domain reset
    action rst {
        cur_element_store_align = 0
        parent.rst()
    }
}

// Equivalent to a runtime assert
module assert_runtime {
    action assert_runtime'0 : bool _condition'0 {}
}

/// TBD add to standard library
module SlowStablePipelineCustom#(T, int PIPELINE_DEPTH) {
    state bool[PIPELINE_DEPTH] cooldown

    domain validity
    action input_changed'0 {
        cooldown = RepeatGen#(T: type bool, V: false, SIZE: PIPELINE_DEPTH)
    } else {
        if PIPELINE_DEPTH >= 1 {
            for int I in 1..PIPELINE_DEPTH {
                cooldown[I - 1] = cooldown[I]
            }
            cooldown[PIPELINE_DEPTH - 1] = true
        }
    }
    output bool pipeline_stable'0
    if PIPELINE_DEPTH == 0 {
        pipeline_stable = true
    } else {
        pipeline_stable = cooldown[0]
    }

    domain data
    input T pipeline_in'PIPELINE_DEPTH
    output T pipeline_out'0
    if PIPELINE_DEPTH == 0 {
        pipeline_out = pipeline_in
    } else {
        pipeline_out = LatencyOffset#(OFFSET: -PIPELINE_DEPTH)(pipeline_in)
    }

    domain reset
    action rst {
        cooldown = RepeatGen#(T: type bool, V: false, SIZE: PIPELINE_DEPTH)
    }
}

/// awaddr = BitwiseIntConcat#(LOWER_BITS: clog2#(V: AXI_WIDTH_BYTES))(first_transfer_idx, 0)
module write_burst_address_manager#(int AXI_WIDTH, int ADDR_WIDTH, int NUM_PARALLEL_ELEMENTS, int ADDR_QUEUE_SIZE, int ADDR_MAY_PUSH_LATENCY, int TOTAL_ELEMENTS_THAT_CAN_BE_STORED) {
    gen int MAX_AXI_ALIGNMENT = pow2#(E: 12) // 4kb page size, a burst cannot cross a 4K boundary
    gen int MAX_BURST = MAX_AXI_ALIGNMENT / (AXI_WIDTH / 8)

    if MAX_BURST > 256 { // Limited to 256 for BURST_INCR - AXI4. (16 if AXI3, but we only support AXI4)
        MAX_BURST = 256
    }

    gen int MAX_BURST_BYTES = MAX_BURST * (AXI_WIDTH / 8)
    gen int MAX_ELEMENTS_IN_BURST = MAX_BURST * NUM_PARALLEL_ELEMENTS

    // The alignment is a power of two
    gen int ELEMENT_BYTES = AXI_WIDTH / NUM_PARALLEL_ELEMENTS / 8
    assert#(C: pow2#(E: clog2#(V: ELEMENT_BYTES)) == ELEMENT_BYTES)

    state int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH) / ELEMENT_BYTES) current_addr
    state int current_command_final_align
    state bool current_addr_valid
    state bool current_command_chunk_end
    state bool current_command_is_last
    state bool current_command_is_empty_burst

    Tuple3 pack_feedback_loop
    SlowStablePipelineCustom feedback_loop
    feedback_loop.pipeline_in = pack_feedback_loop.pack(current_addr, current_command_final_align, current_command_chunk_end)
    int addr_begin_pipeline, int current_command_final_align_begin_pipeline, bool current_command_chunk_end_begin_pipeline = pack_feedback_loop.unpack(feedback_loop.pipeline_out)

    // Split current addr into the current burst idx, the transfer in the burst, and the alignment within the AXI_WIDTH stream
    int cur_burst_idx, int element_in_burst = BitwiseIntSplit#(LOWER_BITS: clog2#(V: MAX_ELEMENTS_IN_BURST))(addr_begin_pipeline)
    int first_transfer_idx, int start_element_offset = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(element_in_burst)

    reg int next_burst_idx = cur_burst_idx + 1 mod pow2#(E: ADDR_WIDTH) / MAX_BURST_BYTES
    int next_burst_addr = BitwiseIntConcat#(LOWER_BITS: clog2#(V: MAX_ELEMENTS_IN_BURST))(next_burst_idx, 0) // Find the first address at the start of the next burst
    
    int last_transfer_to_include
    int last_chunk_offset
    when current_command_chunk_end_begin_pipeline {
        // Since we go until the end of the burst, use 255 as this end marker
        last_transfer_to_include = 255
        reg last_chunk_offset = NUM_PARALLEL_ELEMENTS - 1
    } else {
        // If it were 0, then current_command_chunk_end must be true, and it would have already been reset
        int last_element_before_final_align = IntNarrow#(FROM: 1, TO: MAX_ELEMENTS_IN_BURST)(current_command_final_align_begin_pipeline) - 1
        last_transfer_to_include, reg last_chunk_offset = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(last_element_before_final_align)
    }
    reg int awlen_w = IntNarrow#(FROM: 0, TO: MAX_BURST)(last_transfer_to_include - first_transfer_idx)
    reg bool cur_final_align_is_zero = current_command_final_align_begin_pipeline == 0

    domain addr_output_channel
    // start_offset is inclusive. 1 -> 0111
    // end_offset is also inclusive. 3 -> 1110
    trigger push_burst'0 : int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH) / (AXI_WIDTH / 8)) awaddr'0, int#(FROM: 0, TO: MAX_BURST) awlen'0, int start_offset'0, int end_offset'0, bool is_last'0, bool is_empty_burst'0

    action may_push_burst'0 {
        when current_addr_valid & feedback_loop.pipeline_stable {
            bool should_push_burst = false
            bool last = false
            when current_command_chunk_end {
                should_push_burst = true
                // Set current addr start to the begin of the next burst
                current_command_chunk_end = false
                current_addr = next_burst_addr
                feedback_loop.input_changed()
                // When a is_last happens to coincide with the end of a burst, immediately set is_last, and don't do another request
                when cur_final_align_is_zero {
                    when current_command_is_last {
                        current_addr_valid = false
                    }
                    last = current_command_is_last
                    current_command_is_last = false
                }
            } else when current_command_is_last {
                should_push_burst = true
                last = true
                current_command_is_last = false
                current_addr_valid = false
            }
            when should_push_burst {
                int transfer_addr, int _ = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(current_addr)
                push_burst(transfer_addr, awlen_w, start_element_offset, last_chunk_offset, last, current_command_is_empty_burst)
            }
        }
    }

    // This FIFO guards both the fifo within burst_splitter, as well as the command_fifo. It does this by being as large as both of the others. 
    FWFT#(DEPTH: ADDR_QUEUE_SIZE, MAY_PUSH_LATENCY: ADDR_MAY_PUSH_LATENCY) addr_fifo
    gen int MAX_NUM_FULL_BURSTS_STORED_SIMULTANEOUSLY = TOTAL_ELEMENTS_THAT_CAN_BE_STORED / MAX_ELEMENTS_IN_BURST
    // Twice the number of addresses, because tiny writes may go across the 4K boundary. Plus of course the total number of bursts we could store at one time. At that point the data FIFOs will guard the command FIFO. 
    gen int MAX_NUM_COMMANDS = ADDR_QUEUE_SIZE * 2 + MAX_NUM_FULL_BURSTS_STORED_SIMULTANEOUSLY
    FWFT#(DEPTH: nextPow2#(V: MAX_NUM_COMMANDS), MAY_PUSH_LATENCY: 0) command_fifo
    bool _ = command_fifo.may_push // guarded by addr_fifo
    Tuple4 pack_command
    burst_write_splitter#(MAX_ELEMENTS_IN_BURST, NUM_PARALLEL_ELEMENTS, ADDR_QUEUE_SIZE) burst_splitter

    domain addresses
    trigger may_push_address'-ADDR_MAY_PUSH_LATENCY
    action push_address'0 : int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH)) new_addr'0 {
        int element_aligned_addr, int _addr_misalign = BitwiseIntSplit#(LOWER_BITS: clog2#(V: ELEMENT_BYTES))(new_addr)
        assert_runtime(_addr_misalign == 0)
        addr_fifo.push(element_aligned_addr)
        burst_splitter.push_new_align(element_aligned_addr mod MAX_ELEMENTS_IN_BURST)
    }
    when addr_fifo.may_push {
        may_push_address()
    }

    domain elements
    action push_elements : int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) num_elements, bool is_last_elem -> int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) fifo_offset {
        fifo_offset = burst_splitter.push_elements(num_elements, is_last_elem)
    }

    when burst_splitter.output_command : bool end_of_burst, bool is_last_burst, int#(FROM: 0, TO: MAX_ELEMENTS_IN_BURST) final_align, bool burst_is_empty {
        reg bool[] command = pack_command.pack(end_of_burst, is_last_burst, final_align, burst_is_empty)
        command_fifo.push(command)
    }

    when !current_addr_valid {
        when addr_fifo.pop_available : int new_addr {
            addr_fifo.pop()
            current_addr_valid = true
            current_addr = new_addr
            feedback_loop.input_changed()
        }
    }

    when !current_command_chunk_end & !current_command_is_last {
        when command_fifo.pop_available : bool[] command {
            command_fifo.pop()
            bool chunk_end, bool is_last, int final_align, bool is_empty_burst = pack_command.unpack(command)
            current_command_chunk_end = chunk_end
            current_command_is_last = is_last
            current_command_final_align = final_align
            current_command_is_empty_burst = is_empty_burst
            feedback_loop.input_changed()
        }
    }

    domain reset
    action rst {
        current_addr_valid = false
        current_command_chunk_end = false
        current_command_is_last = false
        addr_fifo.rst()
        command_fifo.rst()
        feedback_loop.rst()
        burst_splitter.rst()
    }
}

/// This module takes in the new adresses, and counts up for every set of elements that comes in. 
module burst_write_splitter#(int MAX_ELEMENTS_IN_BURST, int NUM_PARALLEL_ELEMENTS, int ADDR_QUEUE_SIZE) {
    state int#(FROM: 0, TO: MAX_ELEMENTS_IN_BURST) current_align
    state bool current_align_valid
    state bool current_burst_is_empty

    // Must be a FWFT, because we need to be able to instantly grab the next
    FWFT#(MAY_PUSH_LATENCY: 0, DEPTH: ADDR_QUEUE_SIZE) align_queue
    // Guarded by [write_burst_address_manager::addr_queue]
    bool _ = align_queue.may_push

    domain aligns_fifo
    action push_new_align'0 : int#(FROM: 0, TO: MAX_ELEMENTS_IN_BURST) new_starting_align'0 {
        align_queue.push(new_starting_align)
    }

    domain burst_queue
    trigger output_command : bool end_of_burst, bool is_last_burst, int#(FROM: 0, TO: MAX_ELEMENTS_IN_BURST) final_align, bool burst_is_empty

    domain elements
    bool new_addr_requested = false
    /// fifo_offset refers to the alignment at which this set of elements should start. It's used by the push side of the data FIFOs. 
    /// It should be combined with `num_elements` to make the fifo push strobe. (Using MakeStrobe)
    action push_elements : int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) num_elements, bool is_last -> int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) fifo_offset {
        assert_runtime(current_align_valid)

        fifo_offset = current_align mod NUM_PARALLEL_ELEMENTS
        int current_align_and = current_align + num_elements
        int next_align = current_align_and mod MAX_ELEMENTS_IN_BURST

        bool push_end_of_burst = current_align_and >= MAX_ELEMENTS_IN_BURST

        bool next_current_burst_is_empty = current_burst_is_empty & num_elements == 0
        current_burst_is_empty = next_current_burst_is_empty
        when push_end_of_burst | is_last {
            output_command(push_end_of_burst, is_last, next_align, next_current_burst_is_empty)
        }
        when is_last {
            new_addr_requested = true
        } else {
            current_align = next_align
        }
    }

    when !current_align_valid {
        new_addr_requested = true
    }

    when new_addr_requested {
        when align_queue.pop_available: int new_addr_align {
            current_align_valid = true
            current_align = new_addr_align
            current_burst_is_empty = true
            align_queue.pop()
        } else {
            current_align_valid = false
        }
    }

    domain reset
    action rst {
        current_align_valid = false
        align_queue.rst()
    }
}

module burst_write_fifo_manager#(int AXI_WIDTH, int NUM_PARALLEL_ELEMENTS, int MAX_BURST, int DEPTH, int MAY_PUSH_LATENCY) {
    gen int ELEMENT_BITWIDTH = AXI_WIDTH / NUM_PARALLEL_ELEMENTS
    gen int ELEMENT_BYTEWIDTH = ELEMENT_BITWIDTH / 8

    bool do_rst = false

    // FIFO State
    state int#(FROM: 0, TO: MAX_BURST) transfers_remaining
    state bool pop_strobe_valid
    state bool[NUM_PARALLEL_ELEMENTS] pop_strobe
    state int stored_end_offset
    
    domain push_dom
    // Unpack a bunch of FWFT FIFOs. Sadly this is waiting for submodule arrays
    gen int BARREL_SHIFT_PIPELINE_STAGES = (clog2#(V: NUM_PARALLEL_ELEMENTS) + 1) / 2 + 1
    bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] push_elements'BARREL_SHIFT_PIPELINE_STAGES
    bool[NUM_PARALLEL_ELEMENTS] push_strobe'BARREL_SHIFT_PIPELINE_STAGES
    bool[NUM_PARALLEL_ELEMENTS] may_pushes
    reg reg output bool may_push'-MAY_PUSH_LATENCY = &may_pushes
    action push'0: bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] write_v'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) num_elems'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) fifo_offset'0 {
        push_elements = RotateRight(write_v, fifo_offset)
        push_strobe = MakeStrobe(num_elems, fifo_offset)
    } else {
        push_strobe = RepeatGen#(T: type bool, SIZE: NUM_PARALLEL_ELEMENTS, V: false)
    }
    
    domain axis_data_out
    output bool                wvalid'0
    input  bool                wready'0
    output state bool          wlast'0
    output bool[AXI_WIDTH]     wdata'0
    output bool[AXI_WIDTH / 8] wstrb'0
    for int I in 0..NUM_PARALLEL_ELEMENTS {
        for int J in 0..ELEMENT_BYTEWIDTH {
            wstrb[I * ELEMENT_BYTEWIDTH + J] = pop_strobe[I]
        }
    }

    bool[NUM_PARALLEL_ELEMENTS] pop_available = RepeatGen#(T: type bool, SIZE: NUM_PARALLEL_ELEMENTS, V: false)
    wvalid = &(pop_available | !pop_strobe) & pop_strobe_valid
    bool do_commit_pop = wvalid & wready
    bool may_write_strobe = wvalid & wready | !pop_strobe_valid
    when wvalid & wready {
        pop_strobe_valid = false // May be overwritten same cycle due to may_write_strobe
    }

    // No may_pop, since we're counting & keeping track manually. 

    for int I in 0..NUM_PARALLEL_ELEMENTS {
        FWFT#(T: type bool[ELEMENT_BITWIDTH], DEPTH) fifo

        when push_strobe[I] {
            fifo.push(push_elements[I])
        }
        may_pushes[I] = fifo.may_push

        when fifo.pop_available: bool[ELEMENT_BITWIDTH] pop_data {
            wdata[I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH] = pop_data
            pop_available[I] = true
        }
        when do_commit_pop & pop_strobe[I] {
            fifo.pop()
        }
        when do_rst {
            fifo.rst()
        }
    }

    domain commands
    trigger may_write_burst

    when may_write_strobe {
        when transfers_remaining == 0 {
            may_write_burst()
        } else {
            transfers_remaining = IntNarrow#(FROM: 0, TO: MAX_BURST)(transfers_remaining - 1)
            pop_strobe_valid = true
        }
        when transfers_remaining == 1 { // Last transfer before starting next burst
            pop_strobe = MakeMask(stored_end_offset + 1)
            wlast = true
        } else {
            pop_strobe = RepeatGen#(T: type bool, SIZE: NUM_PARALLEL_ELEMENTS, V: true)
            wlast = false
        }
    }
    action write_burst : int#(FROM: 0, TO: MAX_BURST) transfer_awlen, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) start_offset, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) end_offset {
        pop_strobe_valid = true
        transfers_remaining = transfer_awlen
        stored_end_offset = end_offset
        
        bool[NUM_PARALLEL_ELEMENTS] lower_mask = !MakeMask(start_offset)
        bool[NUM_PARALLEL_ELEMENTS] upper_mask = MakeMask(end_offset + 1)
        when transfer_awlen == 0 {
            pop_strobe = upper_mask & lower_mask
            wlast = true
        } else {
            pop_strobe = lower_mask
            wlast = false
        }
    }

    domain reset
    action rst {
        do_rst = true
        pop_strobe_valid = false
        transfers_remaining = 0
    }
}

/// A Bursting AXI Memory writer. 
///
/// Request new bursts with [may_request_burst] and [request_burst]
/// 
/// Once a burst has been requested, wait until [burst_accepted] goes high before writing data through [may_write] and [write].
/// It is guaranteed that [burst_accepted] goes high after a fixed number of clock cycles, no need for state management around it. 
module axi4_burst_writer #(int AXI_WIDTH, int ADDR_WIDTH, int ADDR_ALIGN, int MAY_PUSH_LATENCY, int ADDR_MAY_PUSH_LATENCY) {
    gen int AXI_WIDTH_BYTES = AXI_WIDTH / 8
    gen int AxSIZE = clog2#(V: AXI_WIDTH_BYTES)

    /// Check AXI_WIDTH is a power of two
    assert#(C: pow2#(E: AxSIZE) * 8 == AXI_WIDTH)
    /// AXI standard supported AXI_WIDTHs: 8 - 1024
    assert#(C: (AxSIZE >= 0) & (AxSIZE < 8))

    /// For XRT: Supported AXI_WIDTH ranges from 32-512
    assert#(C: (AXI_WIDTH == 32) | (AXI_WIDTH == 64) | (AXI_WIDTH == 128) | (AXI_WIDTH == 256) | (AXI_WIDTH == 512))

    gen int MAX_AXI_ALIGNMENT = pow2#(E: 12) // 4kb page size, a burst cannot cross a 4K boundary
    gen int MAX_BURST = MAX_AXI_ALIGNMENT / AXI_WIDTH_BYTES

    if MAX_BURST > 256 { // Limited to 256 for BURST_INCR - AXI4. (16 if AXI3, but we only support AXI4)
        MAX_BURST = 256
    }

    gen int ELEMENT_BITWIDTH = ADDR_ALIGN * 8
    // The alignment is a power of two
    assert#(C: pow2#(E: clog2#(V: ADDR_ALIGN)) == ADDR_ALIGN)
    gen int TRANSFER_SIZE = AXI_WIDTH / 8
    assert#(C: AXI_WIDTH mod ELEMENT_BITWIDTH == 0)

    gen int NUM_PARALLEL_ELEMENTS = TRANSFER_SIZE / ADDR_ALIGN

    gen int FIFO_DEPTH
    if MAY_PUSH_LATENCY > 2 * MAX_BURST {
        FIFO_DEPTH = nextPow2#(V: 2 * MAY_PUSH_LATENCY)
    } else {
        FIFO_DEPTH = nextPow2#(V: MAX_BURST * 2 + MAY_PUSH_LATENCY)
    }
    if FIFO_DEPTH < 512 { // Target BRAMs
        FIFO_DEPTH = 512
    }
    write_burst_address_manager#(
        AXI_WIDTH,
        ADDR_WIDTH,
        NUM_PARALLEL_ELEMENTS,
        ADDR_QUEUE_SIZE: 32,
        ADDR_MAY_PUSH_LATENCY,
        TOTAL_ELEMENTS_THAT_CAN_BE_STORED: FIFO_DEPTH * NUM_PARALLEL_ELEMENTS
    ) addr_manager

    burst_write_fifo_manager#(
        AXI_WIDTH,
        NUM_PARALLEL_ELEMENTS, 
        DEPTH: FIFO_DEPTH,
        MAX_BURST,
        MAY_PUSH_LATENCY: MAY_PUSH_LATENCY+2
    ) fifo_manager

    domain axi4
    output state bool                     awvalid'0
    input  bool                           awready'0
    state int#(FROM: 0, TO: pow2#(E: ADDR_WIDTH) / (AXI_WIDTH / 8)) awaddr_transfer
    output int#(FROM: 0, TO: 1 << ADDR_WIDTH) awaddr'0 = awaddr_transfer << clog2#(V: AXI_WIDTH / 8)
    output int#(FROM: 0, TO: 256)         awlen'0
    output int#(FROM: 0, TO: 8)           awsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                        awburst'0 = 2'b01 // BURST
    output bool[4]                        awcache'0 = 4'b0010 // Not bufferable, but can be broken up (into 128-bit, or other)
    output bool[3]                        awprot'0 = 3'b000 // Unprivileged, Secure, Data Access
    output int#(FROM: 0, TO: 16)          awqos'0 = 0 // Lowest priority
    output bool                           awlock'0 = false // NORMAL - No atomics
    output int#(FROM: 0, TO: 16)          awregion'0 = 0 // Region 0

    output bool                     wvalid'0 = fifo_manager.wvalid
    input  bool                     wready'0
    fifo_manager.wready = wready
    output bool                     wlast'0 = fifo_manager.wlast
    output bool[AXI_WIDTH]          wdata'0 = fifo_manager.wdata
    output bool[AXI_WIDTH / 8]      wstrb'0 = fifo_manager.wstrb

    // 256 bursts in flight aught to be enough for anyone
    Tuple2 burst_is_last_tuple
    FWFT#(DEPTH: 256) burst_is_last_fifo    
    input  bool                     bvalid'0
    input  bool[2]                  bresp'0
    bool[2] _ = bresp // XRT doesn't return useful status codes anyway
    output bool                     bready'0

    domain address
    trigger may_request_new_write'-ADDR_MAY_PUSH_LATENCY
    when addr_manager.may_push_address {
        may_request_new_write()
    }

    action request_new_write'0 : int #(FROM: 0, TO: pow2#(E: ADDR_WIDTH)) start_addr'0 {
        addr_manager.push_address(start_addr)
    }

    state bool is_stored_for_fifo_manager
    state int stored_mgr_start_offset
    state int stored_mgr_end_offset
    state int stored_mgr_awlen
    awlen = stored_mgr_awlen

    when !awvalid & !is_stored_for_fifo_manager & burst_is_last_fifo.may_push {
        addr_manager.may_push_burst()
    }
    when addr_manager.push_burst : int mgr_awaddr, int mgr_awlen, int mgr_start_offset, int mgr_end_offset, bool mgr_is_last, bool is_empty_burst {
        awaddr_transfer = mgr_awaddr
        stored_mgr_awlen = mgr_awlen
        stored_mgr_start_offset = mgr_start_offset
        stored_mgr_end_offset = mgr_end_offset
        awvalid = !is_empty_burst
        is_stored_for_fifo_manager = !is_empty_burst
        burst_is_last_fifo.push(burst_is_last_tuple.pack(mgr_is_last, is_empty_burst))
    }
    when awready & awvalid {
        awvalid = false
    }
    when fifo_manager.may_write_burst {
        when is_stored_for_fifo_manager {
            fifo_manager.write_burst(stored_mgr_awlen, stored_mgr_start_offset, stored_mgr_end_offset)
            is_stored_for_fifo_manager = false
        }
    }

    domain write_commit
    /// After all writes for a burst have been committed to memory, this pulses true. No backpressure, simply don't push addresses you don't know you can handle. 
    output bool write_has_been_committed = false
    bready = false
    when burst_is_last_fifo.pop_available: bool[2] packed_info {
        bool last_burst_just_finished, bool burst_was_empty = burst_is_last_tuple.unpack(packed_info)
        when burst_was_empty {
            write_has_been_committed = true
            burst_is_last_fifo.pop()
        } else {
            bready = true
            when bvalid {
                when last_burst_just_finished {
                    write_has_been_committed = true
                }
                burst_is_last_fifo.pop()
            }
        }
    }

    domain data
    output bool may_write'-MAY_PUSH_LATENCY = fifo_manager.may_push
    // Add some forced pipeline stages on the write signal, such that a write address that's been submitted is ready by the time the data arrives. 
    action write'-3: bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements'1, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) chunk_length'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) chunk_offset'0, bool last'0 {
        // Two pipeline stages here
        reg int chunk_length_d = chunk_length
        reg bool last_d = last
        reg int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) fifo_offset = addr_manager.push_elements(chunk_length_d, last_d)
        fifo_manager.push(elements, chunk_length_d, fifo_offset - chunk_offset mod NUM_PARALLEL_ELEMENTS)
    }

    domain reset
    action rst {
        addr_manager.rst()
        fifo_manager.rst()
        burst_is_last_fifo.rst()
        bready = false
        awvalid = false
        is_stored_for_fifo_manager = false
    }
}
