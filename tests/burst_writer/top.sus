
module bench_burst_writer#(int AXI_WIDTH) {
    clock aclk
    input bool aresetn

    gen int CTRL_AXI_WIDTH = 32
    gen int CTRL_ADDR_WIDTH = 12
    gen int MEM_ADDR_WIDTH = 64

    gen int NUM_PARALLEL_ELEMENTS = AXI_WIDTH / 32

    xrt_ctrl_slave #(NUM_INPUT_REGS: 7, NUM_OUTPUT_REGS: 5, AXI_WIDTH: CTRL_AXI_WIDTH, ADDR_WIDTH: CTRL_ADDR_WIDTH) ctrl

    // Export AXI4-Lite interface
    domain axi_control
    input  int#(FROM: 0, TO: 1 << CTRL_ADDR_WIDTH)    s_axi_control_awaddr
    input  bool                     s_axi_control_awvalid
    output bool                     s_axi_control_awready = ctrl.awready
    input  bool[CTRL_AXI_WIDTH]     s_axi_control_wdata
    input  bool[CTRL_AXI_WIDTH / 8] s_axi_control_wstrb
    input  bool                     s_axi_control_wvalid
    output bool                     s_axi_control_wready  = ctrl.wready
    output bool[2]                  s_axi_control_bresp   = ctrl.bresp
    output bool                     s_axi_control_bvalid  = ctrl.bvalid
    input  bool                     s_axi_control_bready
    input  int#(FROM: 0, TO: 1 << CTRL_ADDR_WIDTH)    s_axi_control_araddr
    input  bool                     s_axi_control_arvalid
    output bool                     s_axi_control_arready = ctrl.arready
    output bool[CTRL_AXI_WIDTH]     s_axi_control_rdata   = ctrl.rdata
    output bool[2]                  s_axi_control_rresp   = ctrl.rresp
    output bool                     s_axi_control_rvalid  = ctrl.rvalid
    input  bool                     s_axi_control_rready
    ctrl.awaddr  =         s_axi_control_awaddr
    ctrl.awvalid =         s_axi_control_awvalid
    ctrl.wdata   =         s_axi_control_wdata
    ctrl.wstrb   =         s_axi_control_wstrb
    ctrl.wvalid  =         s_axi_control_wvalid
    ctrl.bready  =         s_axi_control_bready
    ctrl.araddr  =         s_axi_control_araddr
    ctrl.arvalid =         s_axi_control_arvalid
    ctrl.rready  =         s_axi_control_rready

    axi_reader_tie_off#(ADDR_WIDTH: MEM_ADDR_WIDTH) reader
    axi_burst_writer#(ADDR_WIDTH: MEM_ADDR_WIDTH, ADDR_ALIGN: 4, ADDR_MAY_PUSH_LATENCY: 0) writer

    domain mem_write
    output bool                     m_axi_awvalid = writer.awvalid
    input  bool                     m_axi_awready
    output int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH)     m_axi_awaddr = writer.awaddr
    output int#(FROM: 0, TO: 256)   m_axi_awlen = writer.awlen
    output int#(FROM: 0, TO: 8)     m_axi_awsize  = writer.awsize
    output bool[2]                  m_axi_awburst = writer.awburst
    // output bool[3]                  m_axi_awprot = writer.awprot
    // output bool[4]                  m_axi_awcache = writer.awcache
    // output int#(FROM: 0, TO: 16)    m_axi_awqos = writer.awqos
    // output bool                     m_axi_awlock = writer.awlock
    // output int#(FROM: 0, TO: 16)    m_axi_awregion = writer.awregion
    output bool                     m_axi_wvalid = writer.wvalid
    input  bool                     m_axi_wready
    output bool[AXI_WIDTH]          m_axi_wdata = writer.wdata
    output bool[AXI_WIDTH / 8]      m_axi_wstrb = writer.wstrb
    output bool                     m_axi_wlast = writer.wlast
    input  bool                     m_axi_bvalid
    output bool                     m_axi_bready = writer.bready
    input  bool[2]                  m_axi_bresp
    writer.awready =                m_axi_awready
    writer.wready =                 m_axi_wready
    writer.bvalid =                 m_axi_bvalid
    writer.bresp =                  m_axi_bresp
    domain mem_read
    output bool                     m_axi_arvalid'0 = reader.arvalid
    input  bool                     m_axi_arready
    output int#(FROM: 0, TO: 1 << MEM_ADDR_WIDTH)     m_axi_araddr = reader.araddr
    output int#(FROM: 0, TO: 256)   m_axi_arlen = reader.arlen
    output int#(FROM: 0, TO: 8)     m_axi_arsize  = reader.arsize
    output bool[2]                  m_axi_arburst = reader.arburst
    output bool[3]                  m_axi_arprot = reader.arprot
    output bool[4]                  m_axi_arcache = reader.arcache
    output int#(FROM: 0, TO: 16)    m_axi_arqos = reader.arqos
    output bool                     m_axi_arlock = reader.arlock
    output int#(FROM: 0, TO: 16)    m_axi_arregion = reader.arregion
    input  bool                     m_axi_rvalid
    output bool                     m_axi_rready = reader.rready
    input  bool[AXI_WIDTH]          m_axi_rdata
    input  bool[2]                  m_axi_rresp
    input  bool                     m_axi_rlast
    reader.arready =                m_axi_arready
    reader.rvalid =                 m_axi_rvalid
    reader.rdata =                  m_axi_rdata
    reader.rresp =                  m_axi_rresp
    reader.rlast =                  m_axi_rlast


    bool[64] addr_a_bits
    addr_a_bits[:32] = ctrl.input_regs[0]
    addr_a_bits[32:] = ctrl.input_regs[1]

    int start_addr = BitsToUInt(addr_a_bits)
    int num_to_transfer = BitsToUInt(ctrl.input_regs[2])
    int offset = BitsToUInt(ctrl.input_regs[3])
    int num_repeats = BitsToUInt(ctrl.input_regs[4])
    int repeat_offset = BitsToUInt(ctrl.input_regs[5])

    bool[32] config_bits_w = ctrl.input_regs[6]

    output bool[3]                  m_axi_awprot'0 = config_bits_w[0:3]
    output bool[4]                  m_axi_awcache'0 = config_bits_w[3:7]
    output int#(FROM: 0, TO: 16)    m_axi_awqos'0 = BitsToUInt(config_bits_w[7:11])
    output bool                     m_axi_awlock'0 = config_bits_w[11]
    output int#(FROM: 0, TO: 16)    m_axi_awregion'0 = BitsToUInt(config_bits_w[12:16])

    state int cycles_since_reset
    cycles_since_reset = cycles_since_reset + 1 mod pow2#(E: 64)

    // Add a bunch of pipeline regs to pad out the big add
    reg reg reg bool[64] cycles_since_reset_bits = UIntToBits(cycles_since_reset)

    state bool[64] cycles_since_reset_at_start

    state bool running
    FWFT#(DEPTH: 32) queued_transfers
    state int#(FROM: 0, TO: pow2#(E: 32)) num_repeats_remaining
    state int#(FROM: 0, TO: pow2#(E: 32)) num_repeats_remaining_to_finish
    state int#(FROM: 0, TO: pow2#(E: 32)) num_left_to_transfer
    state bool num_left_to_transfer_valid
    state int#(FROM: 0, TO: pow2#(E: 32) - NUM_PARALLEL_ELEMENTS) cur_idx
    state int#(FROM: 0, TO: pow2#(E: 32)) num_cycles_running

    SlowState#(T: type int#(FROM: 0, TO: pow2#(E: 64)), RESET_TO: 0) cur_experiment_addr
    when ctrl.start {
        num_repeats_remaining = num_repeats
        num_repeats_remaining_to_finish = num_repeats
        cur_experiment_addr.update(start_addr + offset mod pow2#(E: 64))
        running = true
        cur_idx = 0
        num_cycles_running = 0
        cycles_since_reset_at_start = cycles_since_reset_bits
    }

    when num_repeats_remaining != 0 {
        when writer.may_request_new_write {
            when queued_transfers.may_push {
                when cur_experiment_addr.may_update {
                    writer.request_new_write(cur_experiment_addr.old)
                    reg int new_addr = cur_experiment_addr.old + repeat_offset mod pow2#(E: 64)
                    cur_experiment_addr.update(new_addr)
                    queued_transfers.push(0)
                    num_repeats_remaining = num_repeats_remaining - 1 mod pow2#(E: 32)
                }
            }
        }
    }

    when running {
        num_cycles_running = num_cycles_running + 1 mod pow2#(E: 32)
    }

    bool grab_new_transfer = false
    when num_left_to_transfer_valid & writer.may_write {
        bool[32][NUM_PARALLEL_ELEMENTS] write_data
        for int I in 0..NUM_PARALLEL_ELEMENTS {
            write_data[I] = UIntToBits(cur_idx + I)
        }
        int extra_idx
        when num_left_to_transfer <= NUM_PARALLEL_ELEMENTS {
            writer.write(write_data, IntNarrow#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1)(num_left_to_transfer), 0, true)
            grab_new_transfer = true
            extra_idx = num_left_to_transfer
        } else {
            writer.write(write_data, NUM_PARALLEL_ELEMENTS, 0, false)
            num_left_to_transfer = num_left_to_transfer - NUM_PARALLEL_ELEMENTS mod pow2#(E: 32)
            extra_idx = NUM_PARALLEL_ELEMENTS
        }
        cur_idx = IntNarrow#(FROM: 0, TO: pow2#(E: 32) - NUM_PARALLEL_ELEMENTS)(cur_idx + extra_idx)
    }
    when !num_left_to_transfer_valid {
        grab_new_transfer = true
    }
    when grab_new_transfer {
        when queued_transfers.pop_available : int _ {
            num_left_to_transfer = num_to_transfer
            num_left_to_transfer_valid = true
            queued_transfers.pop()
        } else {
            num_left_to_transfer_valid = false
        }
    }

    when writer.write_has_been_committed {
        when num_repeats_remaining_to_finish == 1 {
            running = false
            ctrl.finish([UIntToBits(num_cycles_running), cycles_since_reset_at_start[:32], cycles_since_reset_at_start[32:], cycles_since_reset_bits[:32], cycles_since_reset_bits[32:]])
        }
        num_repeats_remaining_to_finish = IntNarrow#(FROM: 0, TO: pow2#(E: 32))(num_repeats_remaining_to_finish - 1)
    }

    when !aresetn {
        running = false
        num_cycles_running = 0
        num_left_to_transfer = 0
        cycles_since_reset = 0
        num_repeats_remaining = 0
        num_left_to_transfer_valid = false
        reader.rst()
        writer.rst()
        ctrl.rst()
        queued_transfers.rst()
        cur_experiment_addr.rst()
    }
}

module all_write_benchmarks {
    bench_burst_writer#(AXI_WIDTH: 32) bench32
    bench_burst_writer#(AXI_WIDTH: 64) bench64
    bench_burst_writer#(AXI_WIDTH: 128) bench128
    bench_burst_writer#(AXI_WIDTH: 256) bench256
    bench_burst_writer#(AXI_WIDTH: 512) bench512
}
