
module axis_master_fifo#(T, int DEPTH, int MAY_PUSH_LATENCY) {
    FWFT#(DEPTH, MAY_PUSH_LATENCY) fifo
    
    domain clk
    input bool aresetn'0

    when !aresetn {
        fifo.rst()
    }

    domain axis
    input bool tready'0
    output bool tvalid'0
    output bool[sizeof#(T)] tdata'0

    when fifo.pop_available: bool[sizeof#(T)] data {
        tvalid = true
        tdata = data
        when tready {
            fifo.pop()
        }
    } else {
        tvalid = false
    }

    domain push_dom
    output bool may_push'-MAY_PUSH_LATENCY = fifo.may_push
    action push'0: T data'0 {
        fifo.push(ToBits(data))
    }
}
/*module use_axis_master_fifo {
    axis_master_fifo#(T: type bool, DEPTH: 0, MAY_PUSH_LATENCY: 12) m
}*/

/// CTRL REGS is 0x000000
/// Input regs start at 0x000010 and increment 0X000008 every time
/// Output regs start at end of input regs
///
/// XRT imposes a 64K (16bit) address range limitation. 
/// See https://docs.amd.com/r/2023.2-English/ug1393-vitis-application-acceleration/Kernel-Interface-Requirements
///
/// It also appears that ADDR_WIDTH must be >= 12, because the address mapping requires blocks of size 4096
module axi_ctrl_slave #(int NUM_INPUT_REGS, int NUM_OUTPUT_REGS, int ADDR_WIDTH, int AXI_WIDTH) {
    gen int DATA_STARTS_AT_ADDR = 16 // 0x010
    gen int REG_STRIDE = AXI_WIDTH / 8
    gen int CTRL_REG = 0
    gen int FIRST_REG = DATA_STARTS_AT_ADDR / REG_STRIDE
    assert#(C: DATA_STARTS_AT_ADDR mod REG_STRIDE == 0)
    gen int ATO = pow2#(E: ADDR_WIDTH)
    assert#(C: ADDR_WIDTH >= 12)
    assert#(C: ADDR_WIDTH <= 16)
    // Max number of regs
    assert#(C: (FIRST_REG + NUM_INPUT_REGS + NUM_OUTPUT_REGS) * REG_STRIDE <= pow2#(E: ADDR_WIDTH))
    gen bool[2] RESP_OKAY = [false, false]
    gen bool[2] RESP_SLVERR = [false, true]

    domain aclk
    bool do_reset = false

    domain axi4
    // AXI signals
    input int#(FROM: 0, TO: ATO) awaddr
    input bool awvalid
    output bool awready = false
    input bool[AXI_WIDTH] wdata
    input bool[AXI_WIDTH / 8] wstrb
    input bool wvalid
    output bool wready = false
    output bool[2] bresp
    output bool bvalid = false
    input bool bready
    input int#(FROM: 0, TO: ATO) araddr
    input bool arvalid
    output bool arready = false
    output bool[AXI_WIDTH] rdata
    output bool[2] rresp
    output bool rvalid = false
    input bool rready

    domain start_dom
    state bool[32][NUM_OUTPUT_REGS] stored_output_regs
    output state bool[32][NUM_INPUT_REGS] input_regs
    trigger start

    // control register bits
    state bool reg_ctrl_ap_idle
    state bool reg_ctrl_ap_done
    bool reg_ctrl_ap_ready = reg_ctrl_ap_done    // copy ap_done because there's no pausing
    state bool reg_ctrl_ap_start

    // Write transaction
    state int stored_addr
    state bool stored_addr_valid
    state bool[2] last_bresp
    state bool last_werr_valid
    
    awready = !stored_addr_valid & !do_reset // Force low on reset
    wready = stored_addr_valid & !last_werr_valid // Already low by reset
    bvalid = last_werr_valid
    bresp = last_bresp

    when awready & awvalid {
        stored_addr_valid = true
        stored_addr = awaddr / REG_STRIDE
    }
    when wready & wvalid {
        stored_addr_valid = false
        last_werr_valid = true

        last_bresp = RESP_SLVERR
        when stored_addr == CTRL_REG {
            when wstrb[0] & wdata[0] {
                reg_ctrl_ap_start = true
                reg_ctrl_ap_idle = false
                start()
            }
            last_bresp = RESP_OKAY
        }
        // Data Write
        when (stored_addr >= FIRST_REG) & (stored_addr < FIRST_REG + NUM_INPUT_REGS) {
            int write_idx = IntNarrow#(FROM: FIRST_REG, TO: FIRST_REG + NUM_INPUT_REGS)(stored_addr) - FIRST_REG
            for int strbi in 0..4 {
                when wstrb[strbi] {
                    input_regs[write_idx][strbi*8 +: 8] = wdata[strbi*8 +: 8]
                }
            }
            last_bresp = RESP_OKAY
        }
    }
    when bready & bvalid {
        last_werr_valid = false
    }

    // Read transaction
    state bool last_rdata_valid
    state bool[32] last_rdata
    rdata = last_rdata
    state bool[2] last_rresp
    rresp = last_rresp

    bool[32][NUM_INPUT_REGS + NUM_OUTPUT_REGS] regs_read_multiplexer
    regs_read_multiplexer[:NUM_INPUT_REGS] = input_regs
    regs_read_multiplexer[NUM_INPUT_REGS:] = stored_output_regs

    arready = !last_rdata_valid & !do_reset // Force low on reset
    rvalid = last_rdata_valid // Already low by reset

    when arready & arvalid {
        last_rdata_valid = true
        
        // Control Read
        last_rresp = RESP_SLVERR
        int read_addr = araddr / REG_STRIDE
        when read_addr == CTRL_REG {
            last_rdata[0] = reg_ctrl_ap_start
            last_rdata[1] = reg_ctrl_ap_done
            last_rdata[2] = reg_ctrl_ap_idle
            last_rdata[3] = reg_ctrl_ap_ready
            last_rdata[4:] = 28'h0000000
            when reg_ctrl_ap_done {
                reg_ctrl_ap_idle = true
            }
            reg_ctrl_ap_done = false // clear on read
            last_rresp = RESP_OKAY
        }
        // Data Read
        when (read_addr >= FIRST_REG) & (read_addr < FIRST_REG + NUM_INPUT_REGS + NUM_OUTPUT_REGS) {
            int read_idx = IntNarrow#(FROM: FIRST_REG, TO: FIRST_REG + NUM_INPUT_REGS + NUM_OUTPUT_REGS)(read_addr) - FIRST_REG
            last_rdata = regs_read_multiplexer[read_idx]
            last_rresp = RESP_OKAY
        }
    }
    when rready & rvalid {
        last_rdata_valid = false
    }

    domain finish_dom
    action finish'0 : bool[32][NUM_OUTPUT_REGS] output_regs'0 {
        stored_output_regs = output_regs
        reg_ctrl_ap_done = true
        reg_ctrl_ap_start = false
        reg_ctrl_ap_idle = false
    }

    action rst {
        do_reset = true
        stored_addr_valid = false
        last_werr_valid = false

        last_rdata_valid = false

        reg_ctrl_ap_idle = true
        reg_ctrl_ap_start = false
        reg_ctrl_ap_done = false

        input_regs = Repeat(32'h00000000)
        stored_output_regs = Repeat(32'h00000000)
    }
}


module axi_memory_reader_tie_off#(int AXI_WIDTH) {
    gen int ADDR_WIDTH = 64
    gen int ATO = pow2#(E: ADDR_WIDTH)

    domain aclk
    action rst {}

    domain axi4
    // axi mm master
    // read channels - tie off, never ready/valid
    output bool                     arvalid'0 = false
    input  bool                     arready'0
    output int#(FROM: 0, TO: ATO)   araddr'0 = 0
    output int#(FROM: 0, TO: 256)   arlen'0 = 0
    output int#(FROM: 0, TO: 8)     arsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                  arburst'0 = 2'b00
    output bool[3]                  arprot'0 = 3'b00
    output bool[4]                  arcache'0 = 4'b0000
    output int#(FROM: 0, TO: 16)    arqos'0 = 0
    output bool                     arlock'0 = false
    output int#(FROM: 0, TO: 16)    arregion'0 = 0
    input  bool                     rvalid'0
    output bool                     rready'0 = false
    input  bool[AXI_WIDTH]          rdata'0
    input  bool[2]                  rresp'0
    input  bool                     rlast'0
    bool _arready = arready
    bool _rvalid = rvalid
    bool[AXI_WIDTH] _rdata = rdata
    bool[2] _rresp = rresp
    bool _rlast = rlast
}

module axi_memory_writer_tie_off#(int AXI_WIDTH) {
    gen int ADDR_WIDTH = 64
    gen int ATO = pow2#(E: ADDR_WIDTH)

    domain aclk
    action rst {}

    domain axi4
    // axi mm master
    // write channels - tie off, never ready/valid
    output bool                     awvalid'0 = false
    input  bool                     awready'0
    output int#(FROM: 0, TO: ATO)   awaddr'0 = 0
    output int#(FROM: 0, TO: 256)   awlen'0 = 0
    output int#(FROM: 0, TO: 8)     awsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                  awburst'0 = 2'b00
    output bool[3]                  awprot'0 = 3'b000
    output bool[4]                  awcache'0 = 4'b0000
    output int#(FROM: 0, TO: 16)    awqos'0 = 0
    output bool                     awlock'0 = false
    output int#(FROM: 0, TO: 16)    awregion'0 = 0
    output bool                     wvalid'0 = false
    input  bool                     wready'0
    output bool[AXI_WIDTH]          wdata'0 = Repeat(false)
    output bool[AXI_WIDTH / 8]      wstrb'0 = Repeat(false)
    output bool                     wlast'0 = false
    input  bool                     bvalid'0
    input  bool[2]                  bresp'0
    output bool                     bready'0 = false
    bool _awready = awready
    bool _wready = wready
    bool _bvalid = bvalid
    bool[2] _bresp = bresp
}


/// AXI_WIDTH can be 32, 64, 128, 256, or 512
/// sizeof#(T) should be divisible by 8 for <= AXI_WIDTH, and divisible by AXI_WIDTH for larger
module axi_memory_reader #(T, int AXI_WIDTH) {
    assert#(C: (AXI_WIDTH == 32) | (AXI_WIDTH == 64) | (AXI_WIDTH == 128) | (AXI_WIDTH == 256) | (AXI_WIDTH == 512))
    
    gen int ADDR_WIDTH = 64
    gen int ATO = pow2#(E: ADDR_WIDTH)
    gen int MAX_BURST = 256

    gen int NUM_TRANSFERS
    if sizeof#(T) <= AXI_WIDTH {
        NUM_TRANSFERS = 1
        assert#(C: sizeof#(T) mod 8 == 0)
    } else {
        // Actually this code is fine even if it's not a multiple
        // assert#(C: sizeof#(T) mod AXI_WIDTH == 0) // sizeof#(T) must be a multiple of AXI_WIDTH
        assert#(C: sizeof#(T) <= MAX_BURST * AXI_WIDTH) // T is too big!
        NUM_TRANSFERS = sizeof#(T) / AXI_WIDTH
        assert#(C: NUM_TRANSFERS < MAX_BURST) // T is too big!
        assert#(C: sizeof#(T) mod AXI_WIDTH == 0)
    }

    domain aclk
    bool do_rst = false
    action rst {
        do_rst = true
    }

    domain axi4_read
    // read channel
    output bool                     arvalid'0
    input  bool                     arready'0
    output int#(FROM: 0, TO: ATO)   araddr'0
    output int#(FROM: 0, TO: 256)   arlen'0
    output int#(FROM: 0, TO: 8)     arsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                  arburst'0 = 2'b01 // BURST_INC
    output bool[3]                  arprot'0 = 3'b000 // Unprivileged, Secure, Data Access
    output bool[4]                  arcache'0 = 4'b0010 // Not bufferable, but can be broken up (into 128-bit, or other)
    output int#(FROM: 0, TO: 16)    arqos'0 = 0 // Lowest priority
    output bool                     arlock'0 = false // NORMAL - No atomics
    output int#(FROM: 0, TO: 16)    arregion'0 = 0 // Region 0
    input  bool                     rvalid'0
    output bool                     rready'0
    input  bool[AXI_WIDTH]          rdata'0
    input  bool[2]                  rresp'0
    input  bool                     rlast'0
    bool[2] _rresp = rresp // Ignore rresp as we can't handle it anyway
    bool _rlast = rlast

    // control signals
    // Returns "true" if the request was 
    action request : int#(FROM: 0, TO: ATO) addr -> bool fire {
        arvalid = true
        araddr = addr
        arlen = NUM_TRANSFERS - 1 // 0 is used for length '1', 1 for '2', etc. I think this is because a len-0 transfer makes no sense? 
        fire = arready
    } else {
        arvalid = false
    }

    bool do_read
    bool do_read_was_valid
    bool[sizeof#(T)] do_read_data

    if sizeof#(T) <= AXI_WIDTH {
        // rlast should be true
        rready = do_read
        do_read_was_valid = rvalid
        do_read_data = rdata[:sizeof#(T)]
    } else if sizeof#(T) > AXI_WIDTH {
        state int#(FROM: 0, TO: NUM_TRANSFERS) stored_part_idx
        state bool[AXI_WIDTH][NUM_TRANSFERS - 1] stored_parts

        rready = false
        when stored_part_idx < NUM_TRANSFERS - 1 {
            do_read_was_valid = false
            rready = true
            when rvalid {
                int idx = IntNarrow#(FROM: 0, TO: NUM_TRANSFERS - 1)(stored_part_idx)
                stored_parts[idx] = rdata
                stored_part_idx = idx + 1
            }
        } else {
            do_read_was_valid = rvalid
            rready = do_read
            when rready & rvalid {
                // rlast should be true
                stored_part_idx = 0
                for int i in 0..NUM_TRANSFERS-1 {
                    do_read_data[i * AXI_WIDTH +: AXI_WIDTH] = stored_parts[i]
                }
                do_read_data[(NUM_TRANSFERS - 1) * AXI_WIDTH +: AXI_WIDTH] = rdata
            }
        }
        when do_rst {
            stored_part_idx = 0
        }
    }

    action read'0 : -> bool read_valid'0, T data'0 {
        do_read = true
        read_valid = do_read_was_valid
        when do_read_was_valid {
            data = FromBits(do_read_data)
        }
    } else {
        do_read = false
    }
}

/// AXI_WIDTH can be 32, 64, 128, 256, or 512
/// sizeof#(T) should be divisible by 8 for <= AXI_WIDTH, and divisible by AXI_WIDTH for larger
module axi_memory_writer #(T, int AXI_WIDTH) {
    assert#(C: (AXI_WIDTH == 32) | (AXI_WIDTH == 64) | (AXI_WIDTH == 128) | (AXI_WIDTH == 256) | (AXI_WIDTH == 512))
    
    domain aclk

    gen int ADDR_WIDTH = 64
    gen int ATO = pow2#(E: ADDR_WIDTH)
    gen int MAX_BURST = 256
    gen int OUTSTANDING_WRITES_CAPACITY = 256

    gen int NUM_TRANSFERS
    if sizeof#(T) <= AXI_WIDTH {
        NUM_TRANSFERS = 1
        assert#(C: sizeof#(T) mod 8 == 0)
    } else {
        // Actually this code is fine even if it's not a multiple
        // assert#(C: sizeof#(T) mod AXI_WIDTH == 0) // sizeof#(T) must be a multiple of AXI_WIDTH
        assert#(C: sizeof#(T) <= MAX_BURST * AXI_WIDTH) // T is too big!
        NUM_TRANSFERS = sizeof#(T) / AXI_WIDTH
        assert#(C: NUM_TRANSFERS < MAX_BURST) // T is too big!
        assert#(C: sizeof#(T) mod AXI_WIDTH == 0)
    }

    domain axi4_write
    // axi mm master
    // write channels - tie off, never ready/valid
    output bool                     awvalid'0
    input  bool                     awready'0
    output int#(FROM: 0, TO: ATO)   awaddr'0
    output int#(FROM: 0, TO: 256)   awlen'0
    output int#(FROM: 0, TO: 8)     awsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                  awburst'0
    output bool[3]                  awprot'0 = 3'b000 // Unprivileged, Secure, Data Access
    output bool[4]                  awcache'0 = 4'b0010 // Not bufferable, but can be broken up (into 128-bit, or other)
    output int#(FROM: 0, TO: 16)    awqos'0 = 0 // Lowest priority
    output bool                     awlock'0 = false // NORMAL - No atomics
    output int#(FROM: 0, TO: 16)    awregion'0 = 0 // Region 0
    output bool                     wvalid'0
    input  bool                     wready'0
    output bool[AXI_WIDTH]          wdata'0
    output bool[AXI_WIDTH / 8]      wstrb'0
    output bool                     wlast'0
    input  bool                     bvalid'0
    output bool                     bready'0
    input  bool[2]                  bresp'0
    bool[2] _bresp = bresp // ignore bresp, we can't handle errors anyway

    state bool[sizeof#(T)] writing_data
    state bool writing_data_valid
    wvalid = writing_data_valid
    state int#(FROM: 0, TO: OUTSTANDING_WRITES_CAPACITY) num_outstanding_writes
    /// Used to check that all writes have been committed to memory before proceeding
    bready = num_outstanding_writes != 0

    if sizeof#(T) <= AXI_WIDTH {
        wlast = true
        for int BYTE in 0..AXI_WIDTH / 8 {
            if BYTE < sizeof#(T) / 8 {
                wdata[BYTE*8 +: 8] = writing_data[BYTE*8 +: 8]
                wstrb[BYTE] = true
            } else {
                wdata[BYTE*8 +: 8] = 8'h00
                wstrb[BYTE] = false
            }
        }
        when wvalid & wready {
            writing_data_valid = false // fire!
        }
    } else {
        state int#(FROM: 0, TO: NUM_TRANSFERS) cur_data_chunk

        bool[AXI_WIDTH][NUM_TRANSFERS] parts
        for int i in 0..NUM_TRANSFERS {
            parts[i] = writing_data[i * AXI_WIDTH +: AXI_WIDTH]
        }

        wdata = parts[cur_data_chunk]
        wstrb = Repeat(true)
        wlast = !(cur_data_chunk < NUM_TRANSFERS - 1)

        when wvalid & wready {
            // fire!
            when !wlast {
                cur_data_chunk = IntNarrow#(FROM: 0, TO: NUM_TRANSFERS - 1)(cur_data_chunk + 1)
            } else {
                writing_data_valid = false
            }
        }

        when awvalid & awready {
            cur_data_chunk = 0
            // writing_data is already written by the write action
        }
    }

    output bool has_outstanding_writes = bready
    action write : int#(FROM: 0, TO: ATO) addr, T data -> bool write_success {
        awlen = NUM_TRANSFERS - 1 // 0 is used for length '1', 1 for '2', etc. I think this is because a len-0 transfer makes no sense? 
        awburst = 2'b01 // BURST_INC
        awaddr = addr
        awvalid = !writing_data_valid & (num_outstanding_writes < OUTSTANDING_WRITES_CAPACITY - 1)
        write_success = awvalid & awready

        when awvalid & awready {
            writing_data = ToBits(data)
            writing_data_valid = true
        }
    } else {
        awvalid = false
    }

    when awvalid & awready & !(bvalid & bready) {
        num_outstanding_writes = IntNarrow#(FROM: 0, TO: OUTSTANDING_WRITES_CAPACITY - 1)(num_outstanding_writes) + 1
    } else when bvalid & bready & !(awvalid & awready) {
        num_outstanding_writes = IntNarrow#(FROM: 1, TO: OUTSTANDING_WRITES_CAPACITY)(num_outstanding_writes) - 1
    }

    domain reset
    action rst {
        writing_data_valid = false
        num_outstanding_writes = 0
    }
}


/// MakeMask(3) = [true, true, true, false, false, ...]
module MakeMask#(int SIZE) {
    interface MakeMask : int#(FROM: 0, TO: SIZE + 1) up_to -> bool[SIZE] bits

    for int I in 0..SIZE {
        bits[I] = up_to > I
    }
}

module MakeStrobe #(int STROBE_WIDTH) {
    interface MakeStrobe : int#(FROM: 0, TO: STROBE_WIDTH+1) chunk_length'0, int#(FROM: 0, TO: STROBE_WIDTH) chunk_offset'0 -> bool[STROBE_WIDTH] strobe

    strobe = RotateRight(MakeMask(chunk_length), chunk_offset)
}

/// Similar interface to [axi_array_burst_reader]. Used to determine optimal values for [axi_array_burst_reader::MAX_IN_FLIGHT]
module axi_array_burst_reader_benchmarker #(int AXI_WIDTH, int ADDR_ALIGN, int ATO, int COUNT_TO) {
    domain aclk
    gen int AXI_WIDTH_BYTES = AXI_WIDTH / 8
    gen int AxSIZE = clog2#(V: AXI_WIDTH_BYTES)

    /// Check AXI_WIDTH is a power of two
    assert#(C: pow2#(E: AxSIZE) * 8 == AXI_WIDTH)
    /// AXI standard supported AXI_WIDTHs: 8 - 1024
    assert#(C: (AxSIZE >= 0) & (AxSIZE < 8))

    /// For XRT: Supported AXI_WIDTH ranges from 32-512
    assert#(C: (AXI_WIDTH == 32) | (AXI_WIDTH == 64) | (AXI_WIDTH == 128) | (AXI_WIDTH == 256) | (AXI_WIDTH == 512))

    gen int MAX_AXI_ALIGNMENT = pow2#(E: 12)
    // DOES NOT WORK :(
    //gen int MAX_AXI_ALIGNMENT = pow2#(E: 14) // BREAKING AXI SPEC - 8KB pages for 256, 16KB for 512. Result = Higher BW? 
    gen int MAX_BURST = MAX_AXI_ALIGNMENT / AXI_WIDTH_BYTES

    if MAX_BURST > 256 { // Limited to 256 for BURST_INCR - AXI4. (16 if AXI3, but we only support AXI4)
        MAX_BURST = 256
    }

    gen int ELEMENT_BITWIDTH = ADDR_ALIGN * 8
    /// The alignment is a power of two
    assert#(C: pow2#(E: clog2#(V: ADDR_ALIGN)) == ADDR_ALIGN)
    gen int NUM_PARALLEL_ELEMENTS = AXI_WIDTH / ELEMENT_BITWIDTH
    assert#(C: AXI_WIDTH mod ELEMENT_BITWIDTH == 0)

    gen int MAX_BURST_ELEMENTS = MAX_BURST * NUM_PARALLEL_ELEMENTS

    domain axi4
    // axi interface
    output state bool                     arvalid'0
    input  bool                           arready'0
    state int#(FROM: 0, TO: ATO / (AXI_WIDTH / 8)) araddr_transfer
    output int#(FROM: 0, TO: ATO)         araddr'0 = BitwiseIntConcat#(LOWER_BITS: clog2#(V: AXI_WIDTH / 8))(araddr_transfer, 0)
    output state int#(FROM: 0, TO: 256)   arlen'0
    output int#(FROM: 0, TO: 8)           arsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                        arburst'0 = 2'b01 // BURST_INC
    output bool[3]                        arprot'0 = 3'b000 // Unprivileged, Secure, Data Access
    output bool[4]                        arcache'0 = 4'b0010 // Not bufferable, but can be broken up (into 128-bit, or other)
    output int#(FROM: 0, TO: 16)          arqos'0 = 0 // Lowest priority
    output bool                           arlock'0 = false // NORMAL - No atomics
    output int#(FROM: 0, TO: 16)          arregion'0 = 0 // Region 0
    input  bool                           rvalid'0
    output state bool                     rready'0
    input  bool[AXI_WIDTH]                rdata'0
    input  bool[2]                        rresp'0
    bool[2] _rresp = rresp
    input  bool                           rlast'0

    SlowState#(T: type bool, RESET_TO: false, NEW_DELAY: 2) cur_addr_valid
    SlowState#(T: type int#(FROM: 0, TO: ATO / ADDR_ALIGN), RESET_TO: 0, NEW_DELAY: 2) cur_addr
    SlowState#(T: type int#(FROM: 0, TO: COUNT_TO), RESET_TO: 0, NEW_DELAY: 2) elements_remaining
    int addr_burst, int first_elem_in_burst = BitwiseIntSplit#(LOWER_BITS: clog2#(V: MAX_BURST * NUM_PARALLEL_ELEMENTS))(cur_addr.old)
    int first_transfer_idx, int first_elem_in_transfer = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(first_elem_in_burst)

    /// (start_align, end_align (inclusive), is_last_burst, is_zero_sized_burst)
    Tuple4 command_tuple
    FWFT#(DEPTH: 32) command_fifo

    /// Parameter that can be varied to determine the optimal parameter for this 
    input int#(FROM: 0, TO: pow2#(E: 16)) MAX_IN_FLIGHT
    /// Small register updated every cycle keeping live track of how many transfers are in flight. 
    state int#(FROM: 0, TO: pow2#(E: 16)) cur_transfers_in_flight

    domain read_requests
    output bool may_request_new_read'0 = !cur_addr_valid.old & cur_addr_valid.may_update & cur_addr.may_update & elements_remaining.may_update
    action request_new_read'0 : int#(FROM: 0, TO: ATO) start_addr'0, int#(FROM: 0, TO: COUNT_TO) count'0 {
        int elem_addr, int _misalign = BitwiseIntSplit#(LOWER_BITS: clog2#(V: ADDR_ALIGN))(start_addr)

        cur_addr_valid.update(true)
        cur_addr.update(elem_addr)
        elements_remaining.update(count)
    }

    int extra_burst_arlen
    when arready & arvalid {
        extra_burst_arlen = arlen + 1
        arvalid = false
    } else {
        extra_burst_arlen = 0
    }
    cur_transfers_in_flight = cur_transfers_in_flight + extra_burst_arlen - BoolToInt(rready & rvalid) mod pow2#(E: 16)

    domain data
    // It's not possible to encode the backpressure when we have a dynamic MAX_IN_FLIGHT. Luckily, since this is for benchmarking, we simply 
    bool is_ready_to_receive_lots_of_data = true
    trigger element_packet_valid'0: bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) chunk_length'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) chunk_offset'0, bool last'0

    /*

    input bool is_ready_to_receive_lots_of_data'-MAX_IN_FLIGHT
    trigger element_packet_valid'0: bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) chunk_length'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) chunk_offset'0, bool last'0

    bool offset_receiver_is_ready = LatencyOffset#(OFFSET: MAX_IN_FLIGHT)(is_ready_to_receive_lots_of_data)
    when cur_addr_valid & cur_transfers_in_flight < MAX_IN_FLIGHT - MAX_BURST & offset_receiver_is_ready & !arvalid & command_fifo.may_push {
    */

    when cur_addr_valid.old & cur_transfers_in_flight < MAX_IN_FLIGHT - MAX_BURST & is_ready_to_receive_lots_of_data & !arvalid & command_fifo.may_push & cur_addr.may_update & elements_remaining.may_update & cur_addr_valid.may_update {
        int max_number_of_elements_in_this_burst = MAX_BURST_ELEMENTS - first_elem_in_burst
        int reduced_elements_remaining = elements_remaining.old - max_number_of_elements_in_this_burst
        int arlen_value
        int final_align
        // Left undefined at the end of a burst, to clear out the internal state. 
        int next_elements_remaining
        int next_addr 
        bool is_last = reduced_elements_remaining <= 0
        when is_last {
            // The final burst doesn't require us to update the address. 
            int#(FROM: 0, TO: MAX_BURST_ELEMENTS) final_burst_arlen = IntNarrow#(FROM: 0, TO: MAX_BURST_ELEMENTS)(elements_remaining.old + first_elem_in_transfer - 1)
            arlen_value, final_align = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(final_burst_arlen)
            cur_addr_valid.update(false)
        } else {
            // It's not the end of the read
            reg next_elements_remaining = IntNarrow#(FROM: 1, TO: COUNT_TO)(reduced_elements_remaining)
            reg next_addr = BitwiseIntConcat#(LOWER_BITS: clog2#(V: MAX_BURST_ELEMENTS))(addr_burst+1 mod ATO / (MAX_BURST_ELEMENTS * ADDR_ALIGN), 0)
            arlen_value = MAX_BURST - 1 - first_transfer_idx
            final_align = NUM_PARALLEL_ELEMENTS - 1
        }

        // If we requested a 0-element burst, we don't actually make a request, we just send of a "0-burst" command. 
        bool is_zero_sized_burst = elements_remaining.old == 0

        arvalid = !is_zero_sized_burst
        arlen = arlen_value
        araddr_transfer, int _align = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(cur_addr.old)

        elements_remaining.update(next_elements_remaining)
        cur_addr.update(next_addr)
        
        reg bool[] packed_command = command_tuple.pack(first_elem_in_transfer, final_align, is_last, is_zero_sized_burst)
        command_fifo.push(packed_command)
    }

    
    state int chunk_offset
    state int stored_end_align
    state bool stored_is_last
    state bool stored_is_empty_burst

    bool should_get_new_burst = rready & rvalid & rlast | stored_is_empty_burst | !rready
    when should_get_new_burst {
        when command_fifo.pop_available : bool[] pop_data {
            command_fifo.pop()
            int start_align, int end_align, bool is_last, bool is_empty_burst = command_tuple.unpack(pop_data)

            chunk_offset = start_align
            stored_end_align = end_align
            stored_is_last = is_last
            stored_is_empty_burst = is_empty_burst

            rready = !is_empty_burst
        } else {
            rready = false
        }
    }

    bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements
    for int I in 0..NUM_PARALLEL_ELEMENTS {
        elements[I] = rdata[I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH]
    }

    int chunk_length
    bool is_final_last = rlast & stored_is_last
    when is_final_last {
        chunk_length = IntNarrow#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS + 1)(stored_end_align + 1 - chunk_offset)
    } else {
        chunk_length = NUM_PARALLEL_ELEMENTS - chunk_offset
    }
    when rready & rvalid | stored_is_empty_burst {
        int emptied_chunk_length
        when stored_is_empty_burst {
            emptied_chunk_length = 0
        } else {
            emptied_chunk_length = chunk_length
        }
        element_packet_valid(elements, emptied_chunk_length, chunk_offset, is_final_last)
        chunk_offset = 0
        stored_is_empty_burst = false
    }
    
    domain reset
    action rst {
        cur_transfers_in_flight = 0
        arvalid = false
        stored_is_empty_burst = false
        rready = false
        command_fifo.rst()
        cur_addr.rst()
        elements_remaining.rst()
        cur_addr_valid.rst()
    }
}


/*
Vivado Utiliziation report for axi_array_burst_reader#(AXI_WIDTH: 512, ADDR_ALIGN: 4, COUNT_TO: pow2#(E: 16), ATO: pow2#(E: 64))
+-------------------------+------+-------+------------+-----------+-------+
|        Site Type        | Used | Fixed | Prohibited | Available | Util% |
+-------------------------+------+-------+------------+-----------+-------+
| Registers               |  365 |     0 |          0 |   1799680 |  0.02 |
|   Register as Flip Flop |  365 |     0 |          0 |   1799680 |  0.02 |
|   Register as Latch     |    0 |     0 |          0 |   1799680 |  0.00 |
| CLB LUTs*               |  231 |     0 |          0 |    899840 |  0.03 |
|   LUT as Logic          |  231 |     0 |          0 |    899840 |  0.03 |
|   LUT as Memory         |    0 |     0 |          0 |    449920 |  0.00 |
| LOOKAHEAD8              |   12 |     0 |          0 |    112480 |  0.01 |
+-------------------------+------+-------+------------+-----------+-------+
*/
/// A Bursting AXI reader. It spends as little logic as possible, so aligning and backpressure are up to the user. 
///
/// Alignment is not handled by this module. Chunks are delivered on element_packet_valid with a size and valid chunk count. Data is not necessarily aligned to the start of the chunk. For alignment see [axi_burst_reader]
///
/// Very coarse backpressure is provided in the form of the `is_ready_to_receive_lots_of_data` wire. Its latency count is set such that a receiving FIFO can set its ALMOST_FULL treshold to receive all elements in flight (around 192..384). Can be set to constant 'true' if no backpressure needed
/// 
/// element: size is ADDR_ALIGN * 8. It is also the resolution of count
/// chunk: one AXI transfer. Contains AXI_WIDTH / (ADDR_ALIGN * 8) elements
/// burst: 1-256 chunks. The module handles converting the user's large bitwidth element `count` into a sequence of 4K page aligned bursts. `last` is only asserted at the end of the whole read
///
/// Output stream looks like:
/// ...XXXXX
/// XXXXXXXX
/// XXXXX...
/// due to alignment of address
module axi_array_burst_reader #(int AXI_WIDTH, int ADDR_ALIGN, int ATO, int COUNT_TO, int MAX_IN_FLIGHT) {
    domain aclk
    gen int AXI_WIDTH_BYTES = AXI_WIDTH / 8
    gen int AxSIZE = clog2#(V: AXI_WIDTH_BYTES)

    /// Check AXI_WIDTH is a power of two
    assert#(C: pow2#(E: AxSIZE) * 8 == AXI_WIDTH)
    /// AXI standard supported AXI_WIDTHs: 8 - 1024
    assert#(C: (AxSIZE >= 0) & (AxSIZE < 8))

    /// For XRT: Supported AXI_WIDTH ranges from 32-512
    assert#(C: (AXI_WIDTH == 32) | (AXI_WIDTH == 64) | (AXI_WIDTH == 128) | (AXI_WIDTH == 256) | (AXI_WIDTH == 512))

    gen int MAX_AXI_ALIGNMENT = pow2#(E: 12)
    // DOES NOT WORK :(
    //gen int MAX_AXI_ALIGNMENT = pow2#(E: 14) // BREAKING AXI SPEC - 8KB pages for 256, 16KB for 512. Result = Higher BW? 
    gen int MAX_BURST = MAX_AXI_ALIGNMENT / AXI_WIDTH_BYTES

    if MAX_BURST > 256 { // Limited to 256 for BURST_INCR - AXI4. (16 if AXI3, but we only support AXI4)
        MAX_BURST = 256
    }

    gen int ELEMENT_BITWIDTH = ADDR_ALIGN * 8
    /// The alignment is a power of two
    assert#(C: pow2#(E: clog2#(V: ADDR_ALIGN)) == ADDR_ALIGN)
    gen int NUM_PARALLEL_ELEMENTS = AXI_WIDTH / ELEMENT_BITWIDTH
    assert#(C: AXI_WIDTH mod ELEMENT_BITWIDTH == 0)

    gen int MAX_BURST_ELEMENTS = MAX_BURST * NUM_PARALLEL_ELEMENTS

    domain axi4
    // axi interface
    output state bool                     arvalid'0
    input  bool                           arready'0
    state int#(FROM: 0, TO: ATO / (AXI_WIDTH / 8)) araddr_transfer
    output int#(FROM: 0, TO: ATO)         araddr'0 = BitwiseIntConcat#(LOWER_BITS: clog2#(V: AXI_WIDTH / 8))(araddr_transfer, 0)
    output state int#(FROM: 0, TO: 256)   arlen'0
    output int#(FROM: 0, TO: 8)           arsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                        arburst'0 = 2'b01 // BURST_INC
    output bool[3]                        arprot'0 = 3'b000 // Unprivileged, Secure, Data Access
    output bool[4]                        arcache'0 = 4'b0010 // Not bufferable, but can be broken up (into 128-bit, or other)
    output int#(FROM: 0, TO: 16)          arqos'0 = 0 // Lowest priority
    output bool                           arlock'0 = false // NORMAL - No atomics
    output int#(FROM: 0, TO: 16)          arregion'0 = 0 // Region 0
    input  bool                           rvalid'0
    output state bool                     rready'0
    input  bool[AXI_WIDTH]                rdata'0
    input  bool[2]                        rresp'0
    bool[2] _rresp = rresp
    input  bool                           rlast'0

    SlowState#(T: type bool, RESET_TO: false, NEW_DELAY: 2) cur_addr_valid
    SlowState#(T: type int#(FROM: 0, TO: ATO / ADDR_ALIGN), RESET_TO: 0, NEW_DELAY: 2) cur_addr
    SlowState#(T: type int#(FROM: 0, TO: COUNT_TO), RESET_TO: 0, NEW_DELAY: 2) elements_remaining
    int addr_burst, int first_elem_in_burst = BitwiseIntSplit#(LOWER_BITS: clog2#(V: MAX_BURST * NUM_PARALLEL_ELEMENTS))(cur_addr.old)
    int first_transfer_idx, int first_elem_in_transfer = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(first_elem_in_burst)

    /// (start_align, end_align (inclusive), is_last_burst, is_zero_sized_burst)
    Tuple4 command_tuple
    FWFT#(DEPTH: 32) command_fifo

    /// Parameter that can be varied to determine the optimal parameter for this 
    /// Small register updated every cycle keeping live track of how many transfers are in flight. 
    state int#(FROM: 0, TO: MAX_IN_FLIGHT + 1) cur_transfers_in_flight

    domain read_requests
    output bool may_request_new_read'0 = !cur_addr_valid.old & cur_addr_valid.may_update & cur_addr.may_update & elements_remaining.may_update
    action request_new_read'0 : int#(FROM: 0, TO: ATO) start_addr'0, int#(FROM: 0, TO: COUNT_TO) count'0 {
        int elem_addr, int _misalign = BitwiseIntSplit#(LOWER_BITS: clog2#(V: ADDR_ALIGN))(start_addr)

        cur_addr_valid.update(true)
        cur_addr.update(elem_addr)
        elements_remaining.update(count)
    }

    int extra_burst_arlen
    when arready & arvalid {
        extra_burst_arlen = arlen + 1
        arvalid = false
    } else {
        extra_burst_arlen = 0
    }
    cur_transfers_in_flight = cur_transfers_in_flight + extra_burst_arlen - BoolToInt(rready & rvalid) mod pow2#(E: 16)

    domain data
    input bool is_ready_to_receive_lots_of_data'-MAX_IN_FLIGHT
    trigger element_packet_valid'0: bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) chunk_length'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) chunk_offset'0, bool last'0

    bool offset_receiver_is_ready = LatencyOffset#(OFFSET: MAX_IN_FLIGHT)(is_ready_to_receive_lots_of_data)
    when cur_addr_valid.old & cur_transfers_in_flight < MAX_IN_FLIGHT - MAX_BURST & offset_receiver_is_ready & !arvalid & command_fifo.may_push & cur_addr.may_update & elements_remaining.may_update & cur_addr_valid.may_update {
        int max_number_of_elements_in_this_burst = MAX_BURST_ELEMENTS - first_elem_in_burst
        int reduced_elements_remaining = elements_remaining.old - max_number_of_elements_in_this_burst
        int arlen_value
        int final_align
        // Left undefined at the end of a burst, to clear out the internal state. 
        int next_elements_remaining
        int next_addr 
        bool is_last = reduced_elements_remaining <= 0
        when is_last {
            // The final burst doesn't require us to update the address. 
            int#(FROM: 0, TO: MAX_BURST_ELEMENTS) final_burst_arlen = IntNarrow#(FROM: 0, TO: MAX_BURST_ELEMENTS)(elements_remaining.old + first_elem_in_transfer - 1)
            arlen_value, final_align = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(final_burst_arlen)
            cur_addr_valid.update(false)
        } else {
            // It's not the end of the read
            reg next_elements_remaining = IntNarrow#(FROM: 1, TO: COUNT_TO)(reduced_elements_remaining)
            next_addr = BitwiseIntConcat#(LOWER_BITS: clog2#(V: MAX_BURST_ELEMENTS))(addr_burst+1 mod clog2#(V: ATO / MAX_BURST_ELEMENTS), 0)
            arlen_value = MAX_BURST - 1 - first_transfer_idx
            final_align = NUM_PARALLEL_ELEMENTS - 1
        }

        // If we requested a 0-element burst, we don't actually make a request, we just send of a "0-burst" command. 
        bool is_zero_sized_burst = elements_remaining.old == 0

        arvalid = !is_zero_sized_burst
        arlen = arlen_value
        araddr_transfer, int _align = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(next_addr)

        elements_remaining.update(next_elements_remaining)
        reg int next_addr_d = next_addr
        cur_addr.update(next_addr_d)
        
        reg bool[] packed_command = command_tuple.pack(first_elem_in_transfer, final_align, is_last, is_zero_sized_burst)
        command_fifo.push(packed_command)
    }

    
    state int chunk_offset
    state int stored_end_align
    state bool stored_is_last
    state bool stored_is_empty_burst

    bool should_get_new_burst = rready & rvalid & rlast | stored_is_empty_burst | !rready
    when should_get_new_burst {
        when command_fifo.pop_available : bool[] pop_data {
            command_fifo.pop()
            int start_align, int end_align, bool is_last, bool is_empty_burst = command_tuple.unpack(pop_data)

            chunk_offset = start_align
            stored_end_align = end_align
            stored_is_last = is_last
            stored_is_empty_burst = is_empty_burst

            rready = !is_empty_burst
        } else {
            rready = false
        }
    }

    bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements
    for int I in 0..NUM_PARALLEL_ELEMENTS {
        elements[I] = rdata[I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH]
    }

    int chunk_length
    bool is_final_last = rlast & stored_is_last
    when is_final_last {
        chunk_length = IntNarrow#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS + 1)(stored_end_align + 1 - chunk_offset)
    } else {
        chunk_length = NUM_PARALLEL_ELEMENTS - chunk_offset
    }
    when rready & rvalid | stored_is_empty_burst {
        element_packet_valid(elements, chunk_length, chunk_offset, is_final_last)
        chunk_offset = 0
        stored_is_empty_burst = false
    }
    
    domain reset
    action rst {
        cur_transfers_in_flight = 0
        arvalid = false
        stored_is_empty_burst = false
        rready = false
        command_fifo.rst()
        cur_addr.rst()
        elements_remaining.rst()
        cur_addr_valid.rst()
    }
}

/// A Bursting and aligning AXI reader.
/// 
/// As 
/// 
/// Very coarse backpressure is provided in the form of the `is_ready_to_receive_lots_of_data` wire. Its latency count is set such that a receiving FIFO can set its ALMOST_FULL treshold to receive all elements in flight (around 192..384). Can be set to constant 'true' if no backpressure needed
/// 
/// `last` is asserted for the last value
module axi_realigning_burst_reader #(T, int AXI_WIDTH, int ADDR_ALIGN, int COUNT_TO, int ATO, int MAX_IN_FLIGHT) {
    domain aclk

    assert#(C: sizeof#(T) mod ADDR_ALIGN * 8 == 0)
    gen int ELEMENT_BITWIDTH = ADDR_ALIGN * 8
    gen int NUM_ELEMENTS_PER_VALUE = sizeof#(T) / ELEMENT_BITWIDTH
    gen int NUM_PARALLEL_ELEMENTS = AXI_WIDTH / ELEMENT_BITWIDTH
    // When T is bigger than AXI_WIDTH, multiple output cycles would be needed per input transfer. But with this AXI reader, we cannot provide backpressure (without a FIFO that is, of course)
    assert#(C: AXI_WIDTH <= sizeof#(T))
    axi_array_burst_reader #(AXI_WIDTH, ADDR_ALIGN, ATO, COUNT_TO: COUNT_TO * NUM_ELEMENTS_PER_VALUE, MAX_IN_FLIGHT) parent

    // export axi interface
    domain axi4_read
    output bool                     arvalid = parent.arvalid
    input  bool                     arready
    output int#(FROM: 0, TO: ATO)   araddr  = parent.araddr
    output int#(FROM: 0, TO: 256)   arlen   = parent.arlen
    output int#(FROM: 0, TO: 8)     arsize  = parent.arsize
    output bool[2]                  arburst = parent.arburst
    output bool[3]                  arprot = parent.arprot
    output bool[4]                  arcache = parent.arcache
    output int#(FROM: 0, TO: 16)    arqos = parent.arqos
    output bool                     arlock = parent.arlock
    output int#(FROM: 0, TO: 16)    arregion = parent.arregion
    input  bool                     rvalid
    output bool                     rready  = parent.rready
    input  bool[AXI_WIDTH]          rdata
    input  bool[2]                  rresp
    input  bool                     rlast
    parent.arready = arready
    parent.rvalid  = rvalid
    parent.rdata   = rdata
    parent.rresp   = rresp
    parent.rlast   = rlast

    //input int#(FROM: 0, TO: 2048) max_in_flight
    //parent.max_in_flight = max_in_flight

    domain requests
    output bool may_request_new_read = parent.may_request_new_read
    action request_new_read : int#(FROM: 0, TO: ATO) start_addr, int#(FROM: 1, TO: COUNT_TO) count {
        parent.request_new_read(start_addr, count * NUM_ELEMENTS_PER_VALUE)
    }

    domain data
    input bool is_ready_to_receive_lots_of_data'-MAX_IN_FLIGHT
    parent.is_ready_to_receive_lots_of_data = is_ready_to_receive_lots_of_data

    trigger value_valid'0: T value'0, bool last'0

    state bool[ELEMENT_BITWIDTH][NUM_ELEMENTS_PER_VALUE-1] stored_elements
    state int#(FROM: 0, TO: NUM_ELEMENTS_PER_VALUE) cur_element_store_align
    when parent.element_packet_valid : bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] elements, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) chunk_length, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) chunk_offset, bool last {
        bool[ELEMENT_BITWIDTH][NUM_ELEMENTS_PER_VALUE] elements_extended
        elements_extended[:NUM_PARALLEL_ELEMENTS] = elements
        bool[ELEMENT_BITWIDTH][NUM_ELEMENTS_PER_VALUE] rotated_elements = RotateRight(elements_extended, cur_element_store_align - chunk_offset mod NUM_ELEMENTS_PER_VALUE)
        bool[NUM_ELEMENTS_PER_VALUE] rotated_strobe = MakeStrobe(chunk_length, cur_element_store_align)

        int end_of_element = cur_element_store_align + chunk_length

        when end_of_element >= NUM_ELEMENTS_PER_VALUE {
            bool[sizeof#(T)] resulting_value_bits
            gen int MUXES_START_FROM = NUM_ELEMENTS_PER_VALUE - NUM_PARALLEL_ELEMENTS
            for int ELEM_I in 0..NUM_ELEMENTS_PER_VALUE {
                if ELEM_I < MUXES_START_FROM {
                    resulting_value_bits[ELEM_I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH] = stored_elements[ELEM_I]
                } else if ELEM_I == NUM_ELEMENTS_PER_VALUE - 1 {
                    resulting_value_bits[ELEM_I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH] = rotated_elements[ELEM_I]
                } else {
                    when cur_element_store_align > ELEM_I {
                        resulting_value_bits[ELEM_I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH] = stored_elements[ELEM_I]
                    } else {
                        resulting_value_bits[ELEM_I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH] = rotated_elements[ELEM_I]
                    }
                }
            }
            // bool[sizeof#(T)] pipelined_resulting_value_bits'((clog2#(V: NUM_ELEMENTS_PER_VALUE) + 1) / 2) // Estimate 1 MUX4 per stage
            value_valid(FromBits(resulting_value_bits), last)
        }
        cur_element_store_align = end_of_element mod NUM_ELEMENTS_PER_VALUE
        for int ELEM_I in 0..NUM_ELEMENTS_PER_VALUE-1 {
            when rotated_strobe[ELEM_I] {
                stored_elements[ELEM_I] = rotated_elements[ELEM_I]
            }
        }
    }

    domain reset
    action rst {
        cur_element_store_align = 0
        parent.rst()
    }
}

module axis_SkidBuffer#(T) {
    domain aclk
    input bool rst

    domain axis_in
    input T adata
    input bool avalid
    output bool aready

    domain axis_out
    output state T bdata
    output state bool bvalid
    input bool bready

    state T skid
    state bool skid_valid

    aready = !skid_valid

    T next_bdata
    bool next_bvalid
    when skid_valid {
        next_bdata = skid
        next_bvalid = skid_valid
    } else {
        next_bdata = adata
        next_bvalid = avalid
    }
    when !bvalid | bready { // Try to move into bdata
        skid_valid = false
        bdata = next_bdata
        bvalid = next_bvalid
    } else { // Can't move into bdata, must move into skid
        when aready { // There's an implicit && avalid here, but it's not needed
            skid_valid = avalid
            skid = adata
        }
    }

    when rst {
        bvalid = false
        skid_valid = false
    }
}

// Equivalent to a runtime assert
module assert_runtime {
    domain clk
    action assert_runtime'0 : bool _condition'0 {}
}

/// awaddr = BitwiseIntConcat#(LOWER_BITS: clog2#(V: AXI_WIDTH_BYTES))(first_transfer_idx, 0)
module write_burst_address_manager#(int AXI_WIDTH, int ATO, int NUM_PARALLEL_ELEMENTS, int ADDR_QUEUE_SIZE, int ADDR_MAY_PUSH_LATENCY, int TOTAL_ELEMENTS_THAT_CAN_BE_STORED) {
    domain clk
    gen int MAX_AXI_ALIGNMENT = pow2#(E: 12) // 4kb page size, a burst cannot cross a 4K boundary
    gen int MAX_BURST = MAX_AXI_ALIGNMENT / (AXI_WIDTH / 8)

    if MAX_BURST > 256 { // Limited to 256 for BURST_INCR - AXI4. (16 if AXI3, but we only support AXI4)
        MAX_BURST = 256
    }

    gen int MAX_BURST_BYTES = MAX_BURST * (AXI_WIDTH / 8)
    gen int MAX_ELEMENTS_IN_BURST = MAX_BURST * NUM_PARALLEL_ELEMENTS

    // The alignment is a power of two
    gen int ELEMENT_BYTES = AXI_WIDTH / NUM_PARALLEL_ELEMENTS / 8
    assert#(C: pow2#(E: clog2#(V: ELEMENT_BYTES)) == ELEMENT_BYTES)

    SlowState#(T: type int#(FROM: 0, TO: ATO / ELEMENT_BYTES), RESET_TO: 0) current_addr
    SlowState#(T: type bool, RESET_TO: false) current_addr_valid
    SlowState#(T: type bool, RESET_TO: false) current_command_chunk_end
    SlowState#(T: type bool, RESET_TO: false) current_command_is_last
    SlowState#(T: type bool, RESET_TO: false) current_command_is_empty_burst
    SlowState#(T: type int, RESET_TO: 0) current_command_final_align
    
    int first_transfer_idx, int start_element_offset = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(current_addr.old)
    int last_transfer_to_include
    int awlen_w = IntNarrow#(FROM: 0, TO: MAX_BURST)(last_transfer_to_include - (first_transfer_idx mod MAX_BURST))

    domain addr_output_channel
    // start_offset is inclusive. 1 -> 0111
    // end_offset is also inclusive. 3 -> 1110
    trigger push_burst : int#(FROM: 0, TO: ATO / (AXI_WIDTH / 8)) awaddr, int#(FROM: 0, TO: MAX_BURST) awlen, int start_offset, int end_offset, bool is_last, bool is_empty_burst

    action may_push_burst {
        when current_addr.may_update & current_addr_valid.may_update & current_command_chunk_end.may_update & current_command_is_last.may_update & current_command_is_empty_burst.may_update & current_command_final_align.may_update & current_addr_valid.old {
            int transfer_addr, int _ = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(current_addr.old)
            when current_command_chunk_end.old {
                // Since we go until the end of the burst, use 255 as this end marker
                last_transfer_to_include = 255

                push_burst(transfer_addr, awlen_w, start_element_offset, NUM_PARALLEL_ELEMENTS - 1, current_command_final_align.old == 0 & current_command_is_last.old, current_command_is_empty_burst.old)
                // Set current addr start to the begin of the next burst
                current_command_chunk_end.update(false)
                int cur_burst_idx, int _e = BitwiseIntSplit#(LOWER_BITS: clog2#(V: MAX_ELEMENTS_IN_BURST))(current_addr.old)
                int next_burst_idx = cur_burst_idx + 1 mod ATO / MAX_BURST_BYTES // Find the first address at the start of the next burst
                current_addr.update(BitwiseIntConcat#(LOWER_BITS: clog2#(V: MAX_ELEMENTS_IN_BURST))(next_burst_idx, 0))
                // When a is_last happens to coincide with the end of a burst, immediately set is_last, and don't do another request
                when current_command_final_align.old == 0 {
                    when current_command_is_last.old {
                        current_addr_valid.update(false)
                    }
                    current_command_is_last.update(false)
                }
            } else when current_command_is_last.old {
                // If it were 0, then current_command_chunk_end must be true, and it would have already been reset
                int last_element_before_final_align = IntNarrow#(FROM: 1, TO: MAX_ELEMENTS_IN_BURST)(current_command_final_align.old) - 1
                last_transfer_to_include, int last_chunk_offset = BitwiseIntSplit#(LOWER_BITS: clog2#(V: NUM_PARALLEL_ELEMENTS))(last_element_before_final_align)

                push_burst(transfer_addr, awlen_w, start_element_offset, last_chunk_offset, true, current_command_is_empty_burst.old)
                current_command_is_last.update(false)
                current_addr_valid.update(false)
            }
        }
    }

    // This FIFO guards both the fifo within burst_splitter, as well as the command_fifo. It does this by being as large as both of the others. 
    FIFO#(DEPTH: ADDR_QUEUE_SIZE, MAY_PUSH_LATENCY: ADDR_MAY_PUSH_LATENCY) addr_fifo
    gen int MAX_NUM_FULL_BURSTS_STORED_SIMULTANEOUSLY = TOTAL_ELEMENTS_THAT_CAN_BE_STORED / MAX_ELEMENTS_IN_BURST
    // Twice the number of addresses, because tiny writes may go across the 4K boundary. Plus of course the total number of bursts we could store at one time. At that point the data FIFOs will guard the command FIFO. 
    gen int MAX_NUM_COMMANDS = ADDR_QUEUE_SIZE * 2 + MAX_NUM_FULL_BURSTS_STORED_SIMULTANEOUSLY
    FIFO#(DEPTH: MAX_NUM_COMMANDS, MAY_PUSH_LATENCY: 0) command_fifo
    bool _ = command_fifo.may_push // guarded by addr_fifo
    Tuple4 pack_command
    burst_write_splitter#(MAX_ELEMENTS_IN_BURST, NUM_PARALLEL_ELEMENTS, ADDR_QUEUE_SIZE) burst_splitter

    domain addresses
    trigger may_push_address'-ADDR_MAY_PUSH_LATENCY
    action push_address'0 : int#(FROM: 0, TO: ATO) new_addr'0 {
        int element_aligned_addr, int _addr_misalign = BitwiseIntSplit#(LOWER_BITS: clog2#(V: ELEMENT_BYTES))(new_addr)
        assert_runtime(_addr_misalign == 0)
        addr_fifo.push(element_aligned_addr)
        burst_splitter.push_new_align(element_aligned_addr mod MAX_ELEMENTS_IN_BURST)
    }
    when addr_fifo.may_push {
        may_push_address()
    }

    domain elements
    action push_elements : int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) num_elements, bool is_last_elem -> int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) fifo_offset {
        fifo_offset = burst_splitter.push_elements(num_elements, is_last_elem)
    }

    when burst_splitter.output_command : bool end_of_burst, bool is_last_burst, int#(FROM: 0, TO: MAX_ELEMENTS_IN_BURST) final_align, bool burst_is_empty {
        reg bool[] command = pack_command.pack(end_of_burst, is_last_burst, final_align, burst_is_empty)
        command_fifo.push(command)
    }

    when current_addr.may_update & current_addr_valid.may_update & current_command_chunk_end.may_update & current_command_is_last.may_update & current_command_is_empty_burst.may_update & current_command_final_align.may_update {
        when !current_addr_valid.old & addr_fifo.may_pop {
            current_addr_valid.update(true)
            current_addr.update(addr_fifo.pop())
        }

        when !current_command_chunk_end.old & !current_command_is_last.old & command_fifo.may_pop {
            bool chunk_end, bool is_last, int final_align, bool is_empty_burst = pack_command.unpack(command_fifo.pop())
            current_command_chunk_end.update(chunk_end)
            current_command_is_last.update(is_last)
            current_command_final_align.update(final_align)
            current_command_is_empty_burst.update(is_empty_burst)
        }
    }

    domain reset
    action rst {
        current_addr.rst()
        current_addr_valid.rst()
        current_command_chunk_end.rst()
        current_command_is_last.rst()
        current_command_final_align.rst()
        addr_fifo.rst()
        command_fifo.rst()
        burst_splitter.rst()
    }
}

/// This module takes in the new adresses, and counts up for every set of elements that comes in. 
module burst_write_splitter#(int MAX_ELEMENTS_IN_BURST, int NUM_PARALLEL_ELEMENTS, int ADDR_QUEUE_SIZE) {
    domain clk

    state int#(FROM: 0, TO: MAX_ELEMENTS_IN_BURST) current_align
    state bool current_align_valid
    state bool current_burst_is_empty

    // Must be a FWFT, because we need to be able to instantly grab the next 
    FWFT#(MAY_PUSH_LATENCY: 0, DEPTH: ADDR_QUEUE_SIZE) addr_queue
    bool _ = addr_queue.may_push

    domain aligns_fifo
    action push_new_align'0 : int#(FROM: 0, TO: MAX_ELEMENTS_IN_BURST) new_starting_align'0 {
        addr_queue.push(new_starting_align)
    }

    domain burst_queue
    trigger output_command : bool end_of_burst, bool is_last_burst, int#(FROM: 0, TO: MAX_ELEMENTS_IN_BURST) final_align, bool burst_is_empty

    domain elements
    bool new_addr_requested = false
    /// fifo_offset refers to the alignment at which this set of elements should start. It's used by the push side of the data FIFOs. 
    /// It should be combined with `num_elements` to make the fifo push strobe. (Using MakeStrobe)
    action push_elements : int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) num_elements, bool is_last -> int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) fifo_offset {
        assert_runtime(current_align_valid)

        fifo_offset = current_align mod NUM_PARALLEL_ELEMENTS
        int current_align_and = current_align + num_elements
        int next_align = current_align_and mod MAX_ELEMENTS_IN_BURST

        bool push_end_of_burst = current_align_and >= MAX_ELEMENTS_IN_BURST

        bool next_current_burst_is_empty = current_burst_is_empty & num_elements == 0
        current_burst_is_empty = next_current_burst_is_empty
        when push_end_of_burst | is_last {
            output_command(push_end_of_burst, is_last, next_align, next_current_burst_is_empty)
        }
        when is_last {
            new_addr_requested = true
        } else {
            current_align = next_align
        }
    }

    when !current_align_valid {
        new_addr_requested = true
    }

    when new_addr_requested {
        when addr_queue.pop_available: int new_addr_align {
            current_align_valid = true
            current_align = new_addr_align
            current_burst_is_empty = true
            addr_queue.pop()
        } else {
            current_align_valid = false
        }
    }

    domain reset
    action rst {
        current_align_valid = false
        addr_queue.rst()
    }
}

module burst_write_fifo_manager#(int AXI_WIDTH, int NUM_PARALLEL_ELEMENTS, int MAX_BURST, int DEPTH, int MAY_PUSH_LATENCY) {
    gen int ELEMENT_BITWIDTH = AXI_WIDTH / NUM_PARALLEL_ELEMENTS
    gen int ELEMENT_BYTEWIDTH = ELEMENT_BITWIDTH / 8
    domain clk
    bool do_rst = false

    // FIFO State
    state int#(FROM: 0, TO: MAX_BURST) transfers_remaining
    state bool pop_strobe_valid
    state bool[NUM_PARALLEL_ELEMENTS] pop_strobe
    state int stored_end_offset
    
    domain push_dom
    // Unpack a bunch of FWFT FIFOs. Sadly this is waiting for submodule arrays
    gen int BARREL_SHIFT_PIPELINE_STAGES = (clog2#(V: NUM_PARALLEL_ELEMENTS) + 1) / 2 + 1
    bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] push_elements'BARREL_SHIFT_PIPELINE_STAGES
    bool[NUM_PARALLEL_ELEMENTS] push_strobe'BARREL_SHIFT_PIPELINE_STAGES
    bool[NUM_PARALLEL_ELEMENTS] may_pushes
    reg reg output bool may_push'-MAY_PUSH_LATENCY = &may_pushes
    action push'0: bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] write_v'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) num_elems'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) fifo_offset'0 {
        push_elements = RotateRight(write_v, fifo_offset)
        push_strobe = MakeStrobe(num_elems, fifo_offset)
    } else {
        push_strobe = RepeatGen#(T: type bool, SIZE: NUM_PARALLEL_ELEMENTS, V: false)
    }
    
    domain axis_data_out
    output bool                wvalid'0
    input  bool                wready'0
    output state bool          wlast'0
    output bool[AXI_WIDTH]     wdata'0
    output bool[AXI_WIDTH / 8] wstrb'0
    for int I in 0..NUM_PARALLEL_ELEMENTS {
        for int J in 0..ELEMENT_BYTEWIDTH {
            wstrb[I * ELEMENT_BYTEWIDTH + J] = pop_strobe[I]
        }
    }

    bool[NUM_PARALLEL_ELEMENTS] pop_available = RepeatGen#(T: type bool, SIZE: NUM_PARALLEL_ELEMENTS, V: false)
    wvalid = &(pop_available | !pop_strobe) & pop_strobe_valid
    bool do_commit_pop = wvalid & wready
    bool may_write_strobe = wvalid & wready | !pop_strobe_valid
    when wvalid & wready {
        pop_strobe_valid = false // May be overwritten same cycle due to may_write_strobe
    }

    // No may_pop, since we're counting & keeping track manually. 

    for int I in 0..NUM_PARALLEL_ELEMENTS {
        FWFT#(T: type bool[ELEMENT_BITWIDTH], DEPTH) fifo

        when push_strobe[I] {
            fifo.push(push_elements[I])
        }
        may_pushes[I] = fifo.may_push

        when fifo.pop_available: bool[ELEMENT_BITWIDTH] pop_data {
            wdata[I * ELEMENT_BITWIDTH +: ELEMENT_BITWIDTH] = pop_data
            pop_available[I] = true
        }
        when do_commit_pop & pop_strobe[I] {
            fifo.pop()
        }
        when do_rst {
            fifo.rst()
        }
    }

    domain commands
    trigger may_write_burst

    when may_write_strobe {
        when transfers_remaining == 0 {
            may_write_burst()
        } else {
            transfers_remaining = IntNarrow#(FROM: 0, TO: MAX_BURST)(transfers_remaining - 1)
            pop_strobe_valid = true
        }
        when transfers_remaining == 1 { // Last transfer before starting next burst
            pop_strobe = MakeMask(stored_end_offset + 1)
            wlast = true
        } else {
            pop_strobe = RepeatGen#(T: type bool, SIZE: NUM_PARALLEL_ELEMENTS, V: true)
            wlast = false
        }
    }
    action write_burst : int#(FROM: 0, TO: MAX_BURST) transfer_awlen, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) start_offset, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) end_offset {
        pop_strobe_valid = true
        transfers_remaining = transfer_awlen
        stored_end_offset = end_offset
        
        bool[NUM_PARALLEL_ELEMENTS] lower_mask = !MakeMask(start_offset)
        bool[NUM_PARALLEL_ELEMENTS] upper_mask = MakeMask(end_offset + 1)
        when transfer_awlen == 0 {
            pop_strobe = upper_mask & lower_mask
            wlast = true
        } else {
            pop_strobe = lower_mask
            wlast = false
        }
    }

    domain reset
    action rst {
        do_rst = true
        pop_strobe_valid = false
        transfers_remaining = 0
    }
}

/// A Bursting AXI Memory writer. 
///
/// Request new bursts with [may_request_burst] and [request_burst]
/// 
/// Once a burst has been requested, wait until [burst_accepted] goes high before writing data through [may_write] and [write].
/// It is guaranteed that [burst_accepted] goes high after a fixed number of clock cycles, no need for state management around it. 
module axi_array_burst_writer #(int AXI_WIDTH, int ADDR_ALIGN, int ATO, int MAY_PUSH_LATENCY, int ADDR_MAY_PUSH_LATENCY) {
    gen int AXI_WIDTH_BYTES = AXI_WIDTH / 8
    gen int AxSIZE = clog2#(V: AXI_WIDTH_BYTES)

    /// Check AXI_WIDTH is a power of two
    assert#(C: pow2#(E: AxSIZE) * 8 == AXI_WIDTH)
    /// AXI standard supported AXI_WIDTHs: 8 - 1024
    assert#(C: (AxSIZE >= 0) & (AxSIZE < 8))

    /// For XRT: Supported AXI_WIDTH ranges from 32-512
    assert#(C: (AXI_WIDTH == 32) | (AXI_WIDTH == 64) | (AXI_WIDTH == 128) | (AXI_WIDTH == 256) | (AXI_WIDTH == 512))

    gen int MAX_AXI_ALIGNMENT = pow2#(E: 12) // 4kb page size, a burst cannot cross a 4K boundary
    gen int MAX_BURST = MAX_AXI_ALIGNMENT / AXI_WIDTH_BYTES

    if MAX_BURST > 256 { // Limited to 256 for BURST_INCR - AXI4. (16 if AXI3, but we only support AXI4)
        MAX_BURST = 256
    }

    gen int ELEMENT_BITWIDTH = ADDR_ALIGN * 8
    // The alignment is a power of two
    assert#(C: pow2#(E: clog2#(V: ADDR_ALIGN)) == ADDR_ALIGN)
    gen int TRANSFER_SIZE = AXI_WIDTH / 8
    assert#(C: AXI_WIDTH mod ELEMENT_BITWIDTH == 0)

    gen int NUM_PARALLEL_ELEMENTS = TRANSFER_SIZE / ADDR_ALIGN

    gen int FIFO_DEPTH
    if MAY_PUSH_LATENCY > 2 * MAX_BURST {
        FIFO_DEPTH = nextPow2#(V: 2 * MAY_PUSH_LATENCY)
    } else {
        FIFO_DEPTH = nextPow2#(V: MAX_BURST * 2 + MAY_PUSH_LATENCY)
    }
    if FIFO_DEPTH < 512 { // Target BRAMs
        FIFO_DEPTH = 512
    }
    write_burst_address_manager#(
        AXI_WIDTH,
        ATO,
        NUM_PARALLEL_ELEMENTS,
        ADDR_QUEUE_SIZE: 20,
        ADDR_MAY_PUSH_LATENCY,
        TOTAL_ELEMENTS_THAT_CAN_BE_STORED: FIFO_DEPTH * NUM_PARALLEL_ELEMENTS
    ) addr_manager

    burst_write_fifo_manager#(
        AXI_WIDTH,
        NUM_PARALLEL_ELEMENTS, 
        DEPTH: FIFO_DEPTH,
        MAX_BURST,
        MAY_PUSH_LATENCY: MAY_PUSH_LATENCY+2
    ) fifo_manager

    domain aclk

    domain axi4
    output state bool                     awvalid'0 = false
    input  bool                           awready'0
    state int#(FROM: 0, TO: ATO / (AXI_WIDTH / 8)) awaddr_transfer
    output int#(FROM: 0, TO: ATO)         awaddr'0 = BitwiseIntConcat#(LOWER_BITS: clog2#(V: AXI_WIDTH / 8))(awaddr_transfer, 0)
    output int#(FROM: 0, TO: 256)         awlen'0
    output int#(FROM: 0, TO: 8)           awsize'0 = clog2#(V: AXI_WIDTH / 8)
    output bool[2]                        awburst'0 = 2'b01 // BURST
    output bool[4]                        awcache'0 = 4'b0010 // Not bufferable, but can be broken up (into 128-bit, or other)
    output bool[3]                        awprot'0 = 3'b000 // Unprivileged, Secure, Data Access
    output int#(FROM: 0, TO: 16)          awqos'0 = 0 // Lowest priority
    output bool                           awlock'0 = false // NORMAL - No atomics
    output int#(FROM: 0, TO: 16)          awregion'0 = 0 // Region 0

    output bool                     wvalid'0 = fifo_manager.wvalid
    input  bool                     wready'0
    fifo_manager.wready = wready
    output bool                     wlast'0 = fifo_manager.wlast
    output bool[AXI_WIDTH]          wdata'0 = fifo_manager.wdata
    output bool[AXI_WIDTH / 8]      wstrb'0 = fifo_manager.wstrb

    // 32 bursts in flight aught to be enough for anyone
    Tuple2 burst_is_last_tuple
    FWFT#(DEPTH: 32) burst_is_last_fifo    
    input  bool                     bvalid'0
    input  bool[2]                  bresp'0
    bool[2] _ = bresp // XRT doesn't return useful status codes anyway
    output bool                     bready'0

    domain address
    trigger may_request_new_write'-ADDR_MAY_PUSH_LATENCY
    when addr_manager.may_push_address {
        may_request_new_write()
    }

    action request_new_write'0 : int #(FROM: 0, TO: ATO) start_addr'0 {
        addr_manager.push_address(start_addr)
    }

    state bool is_stored_for_fifo_manager
    state int stored_mgr_start_offset
    state int stored_mgr_end_offset
    state int stored_mgr_awlen
    awlen = stored_mgr_awlen

    when !awvalid & !is_stored_for_fifo_manager & burst_is_last_fifo.may_push {
        addr_manager.may_push_burst()
    }
    when addr_manager.push_burst : int mgr_awaddr, int mgr_awlen, int mgr_start_offset, int mgr_end_offset, bool mgr_is_last, bool is_empty_burst {
        awaddr_transfer = mgr_awaddr
        stored_mgr_awlen = mgr_awlen
        stored_mgr_start_offset = mgr_start_offset
        stored_mgr_end_offset = mgr_end_offset
        awvalid = !is_empty_burst
        is_stored_for_fifo_manager = !is_empty_burst
        burst_is_last_fifo.push(burst_is_last_tuple.pack(mgr_is_last, is_empty_burst))
    }
    when awready & awvalid {
        awvalid = false
    }
    when fifo_manager.may_write_burst {
        when is_stored_for_fifo_manager {
            fifo_manager.write_burst(stored_mgr_awlen, stored_mgr_start_offset, stored_mgr_end_offset)
            is_stored_for_fifo_manager = false
        }
    }

    domain write_commit
    /// After all writes for a burst have been committed to memory, this pulses true. No backpressure, simply don't push addresses you don't know you can handle. 
    trigger write_has_been_committed
    bready = false
    when burst_is_last_fifo.pop_available: bool[2] packed_info {
        bool last_burst_just_finished, bool burst_was_empty = burst_is_last_tuple.unpack(packed_info)
        when burst_was_empty {
            write_has_been_committed()
            burst_is_last_fifo.pop()
        } else {
            bready = true
            when bvalid {
                when last_burst_just_finished {
                    write_has_been_committed()
                }
                burst_is_last_fifo.pop()
            }
        }
    }

    domain elements
    output bool may_write'-MAY_PUSH_LATENCY = fifo_manager.may_push
    // Add some forced pipeline stages on the write signal, such that a write address that's been submitted is ready by the time the data arrives. 
    action write'-3: bool[ELEMENT_BITWIDTH][NUM_PARALLEL_ELEMENTS] write_v'1, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS+1) num_elems'0, int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) strobe_offset'0, bool is_last'0 {
        // Two pipeline stages here
        reg int num_elems_d = num_elems
        reg bool is_last_d = is_last
        reg int#(FROM: 0, TO: NUM_PARALLEL_ELEMENTS) fifo_offset = addr_manager.push_elements(num_elems_d, is_last_d)
        fifo_manager.push(write_v, num_elems_d, fifo_offset - strobe_offset mod NUM_PARALLEL_ELEMENTS)
    }

    domain reset
    action rst {
        addr_manager.rst()
        fifo_manager.rst()
        burst_is_last_fifo.rst()
        bready = false
        awvalid = false
        is_stored_for_fifo_manager = false
    }
}
